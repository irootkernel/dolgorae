{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dolgorae.local/schema/specialist-policy/v2",
  "title": "Dolgorae immutable installed Specialist Policy snapshot v2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "policy_name",
    "revision",
    "approval_policy",
    "max_active_specialists",
    "roles"
  ],
  "properties": {
    "schema_version": {
      "const": 2
    },
    "policy_name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "pattern": "^[a-z0-9][a-z0-9._-]{0,63}$"
    },
    "revision": {
      "type": "integer",
      "minimum": 1
    },
    "approval_policy": {
      "enum": [
        "user_approval_required",
        "fully_delegated"
      ]
    },
    "max_active_specialists": {
      "type": "integer",
      "minimum": 1,
      "maximum": 64
    },
    "roles": {
      "type": "array",
      "minItems": 1,
      "maxItems": 64,
      "items": {
        "$ref": "#/$defs/role_policy"
      }
    }
  },
  "$defs": {
    "role_source_reference": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "scope",
        "name"
      ],
      "properties": {
        "scope": {
          "enum": [
            "common",
            "project"
          ]
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64,
          "pattern": "^[a-z0-9][a-z0-9._-]{0,63}$"
        }
      }
    },
    "role_policy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "role_ref",
        "role_source",
        "role_source_sha256",
        "role",
        "agent_configuration",
        "max_active_instances",
        "reuse_policy",
        "allowed_access",
        "activation_policy",
        "primary_may_request",
        "collaboration_source",
        "collaboration_target",
        "auto_approve_when_fully_delegated"
      ],
      "properties": {
        "role_ref": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64,
          "pattern": "^[a-z0-9][a-z0-9._-]{0,63}$"
        },
        "role_source": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "scope",
            "name"
          ],
          "properties": {
            "scope": {
              "enum": [
                "common",
                "project"
              ]
            },
            "name": {
              "type": "string",
              "minLength": 1,
              "maxLength": 64,
              "pattern": "^[a-z0-9][a-z0-9._-]{0,63}$"
            }
          }
        },
        "role_source_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "role": {
          "$ref": "https://dolgorae.local/schema/role-source/v1"
        },
        "agent_configuration": {
          "$ref": "https://dolgorae.local/schema/agent-configuration/v2"
        },
        "max_active_instances": {
          "type": "integer",
          "minimum": 1,
          "maximum": 16
        },
        "reuse_policy": {
          "enum": [
            "never",
            "reuse_idle_compatible",
            "reuse_any_compatible"
          ]
        },
        "allowed_access": {
          "type": "array",
          "minItems": 1,
          "maxItems": 3,
          "uniqueItems": true,
          "items": {
            "enum": [
              "read_only",
              "isolated_write",
              "canonical_workspace_write"
            ]
          }
        },
        "activation_policy": {
          "enum": [
            "on_mail",
            "manual",
            "keep_resident",
            "never"
          ]
        },
        "primary_may_request": {
          "type": "boolean"
        },
        "collaboration_source": {
          "type": "boolean"
        },
        "collaboration_target": {
          "type": "boolean"
        },
        "auto_approve_when_fully_delegated": {
          "type": "boolean"
        }
      }
    }
  },
  "x-invariants": [
    "role_ref values are unique",
    "role_source_sha256 is the JCS SHA-256 of role",
    "role.name equals role_source.name",
    "agent_configuration.role_reference equals role_ref",
    "the installed policy has no live source-path dependency",
    "write-capable roles require a dedicated execution lane",
    "collaboration-capable roles use on_mail or keep_resident activation"
  ]
}
