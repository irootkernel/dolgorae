{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dolgorae.local/schema/public-resolution/v2",
  "title": "Public resolution intent and retained receipt v2",
  "oneOf": [
    {
      "$ref": "#/$defs/intent"
    },
    {
      "$ref": "#/$defs/receipt"
    }
  ],
  "$defs": {
    "intent": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema",
        "body"
      ],
      "properties": {
        "schema": {
          "const": "dolgorae.public-resolution-intent/v2"
        },
        "body": {
          "$ref": "https://dolgorae.local/schema/machine-output/v5#/$defs/resolve_interaction_normalized_body"
        }
      }
    },
    "receipt": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema",
        "mutation_envelope",
        "accepted_input_digest",
        "operation_ref",
        "accepted_subjects",
        "contains_protected_input"
      ],
      "properties": {
        "schema": {
          "const": "dolgorae.public-resolution-receipt/v2"
        },
        "mutation_envelope": {
          "$ref": "https://dolgorae.local/schema/v014-identities/v1#/$defs/mutation_envelope"
        },
        "accepted_input_digest": {
          "type": "string",
          "pattern": "^sha256:[a-f0-9]{64}$"
        },
        "operation_ref": {
          "type": "string",
          "format": "uuid",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
        },
        "accepted_subjects": {
          "$ref": "https://dolgorae.local/schema/v014-identities/v1#/$defs/accepted_subjects"
        },
        "contains_protected_input": {
          "type": "boolean"
        }
      },
      "allOf": [
        {
          "properties": {
            "mutation_envelope": {
              "properties": {
                "operation_kind": {
                  "const": "resolve_interaction"
                },
                "scope_kind": {
                  "const": "run"
                },
                "request_schema": {
                  "const": "https://dolgorae.local/schema/machine-output/v5#/$defs/resolve_interaction_normalized_body"
                }
              }
            }
          }
        }
      ],
      "x-invariants": [
        "The serialized actor creates this receipt atomically with the winning ApprovalDecided record.",
        "The accepted input digest is the JCS mutation-envelope digest. Accepted subjects identify the original Run, Turn and interaction.",
        "contains_protected_input derives from authoritative interaction metadata. It is separate from the normalized protected_input_present carrier-presence fact.",
        "Protected content, paths and their hashes are excluded. Historical decisions without this receipt remain unresolved to public LookupOperation."
      ]
    }
  }
}
