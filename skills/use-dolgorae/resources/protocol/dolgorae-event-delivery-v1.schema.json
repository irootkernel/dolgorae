{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dolgorae.local/schema/event-delivery/v1",
  "title": "Dolgorae event delivery v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "kind", "projection", "replay", "record"],
  "properties": {
    "schema_version": { "const": 1 },
    "kind": { "const": "event" },
    "projection": { "enum": ["minimal", "operational"] },
    "replay": { "type": "boolean" },
    "record": { "$ref": "https://dolgorae.local/schema/client-event-record/v1" }
  },
  "oneOf": [
    {
      "properties": {
        "projection": { "const": "minimal" },
        "record": {
          "allOf": [
            { "$ref": "https://dolgorae.local/schema/client-event-record/v1" },
            { "properties": { "type": { "enum": ["run.state_changed", "turn.state_changed", "response.final", "interaction.opened", "interaction.resolved", "runtime.error", "writer.state_changed", "recovery.required"] } } }
          ]
        }
      }
    },
    {
      "properties": {
        "projection": { "const": "operational" },
        "record": { "$ref": "https://dolgorae.local/schema/client-event-record/v1" }
      }
    }
  ]
}
