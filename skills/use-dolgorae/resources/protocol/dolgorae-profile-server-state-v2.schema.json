{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dolgorae.local/schema/profile-server-state/v2",
  "title": "Dolgorae global Profile server state v2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "server_key",
    "lifecycle",
    "server_epoch",
    "epoch_id",
    "boot_session_uuid",
    "pid",
    "pgid",
    "uid",
    "process_fingerprint",
    "drainer_pid",
    "drainer_pgid",
    "drainer_uid",
    "drainer_fingerprint",
    "socket_path",
    "socket_device",
    "socket_inode",
    "membership_revision",
    "default_model",
    "models",
    "capabilities",
    "snapshot"
  ],
  "properties": {
    "schema_version": {
      "const": 2
    },
    "server_key": {
      "$ref": "#/$defs/sha256"
    },
    "lifecycle": {
      "enum": [
        "starting",
        "ready",
        "degraded",
        "stopping",
        "restarting",
        "migrating",
        "migration_blocked"
      ]
    },
    "server_epoch": {
      "type": "integer",
      "minimum": 1
    },
    "epoch_id": {
      "type": "string",
      "format": "uuid"
    },
    "boot_session_uuid": {
      "type": "string",
      "format": "uuid"
    },
    "pid": {
      "type": "integer",
      "minimum": 1
    },
    "pgid": {
      "type": "integer",
      "minimum": 1
    },
    "uid": {
      "type": "integer",
      "minimum": 0
    },
    "process_fingerprint": {
      "type": "string",
      "minLength": 1
    },
    "drainer_pid": {
      "type": "integer",
      "minimum": 1
    },
    "drainer_pgid": {
      "type": "integer",
      "minimum": 1
    },
    "drainer_uid": {
      "type": "integer",
      "minimum": 0
    },
    "drainer_fingerprint": {
      "type": "string",
      "minLength": 1
    },
    "socket_path": {
      "type": "string",
      "minLength": 1,
      "pattern": "^/"
    },
    "socket_device": {
      "type": "integer",
      "description": "Device of the verified physical Codex Unix socket, following only its deterministic protected rendezvous.",
      "minimum": 0
    },
    "socket_inode": {
      "type": "integer",
      "description": "Inode of the verified physical Codex Unix socket.",
      "minimum": 0
    },
    "membership_revision": {
      "type": "integer",
      "minimum": 0
    },
    "default_model": {
      "type": "string",
      "minLength": 1
    },
    "models": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "capabilities": {
      "$ref": "#/$defs/capabilities"
    },
    "snapshot": {
      "$ref": "#/$defs/snapshot"
    }
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "capabilities": {
      "type": "object",
      "additionalProperties": {
        "enum": [
          "supported",
          "recognized_unsupported",
          "unavailable",
          "unverified"
        ]
      }
    },
    "executable_identity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "resolved_path",
        "device",
        "inode",
        "sha256"
      ],
      "properties": {
        "resolved_path": {
          "type": "string",
          "minLength": 1
        },
        "device": {
          "type": "integer",
          "minimum": 0
        },
        "inode": {
          "type": "integer",
          "minimum": 0
        },
        "sha256": {
          "$ref": "#/$defs/sha256"
        }
      }
    },
    "snapshot": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "profile_name",
        "canonical_codex_home",
        "normalized_argv",
        "launch_cwd_policy",
        "derived_launch_cwd",
        "sanitized_environment",
        "enabled_features",
        "disabled_features",
        "process_static_configuration",
        "initial_configuration_observation",
        "executable_identity",
        "codex_version",
        "schema_bundle_sha256",
        "compatibility_manifest_sha256",
        "launch_contract_sha256",
        "compatibility_verdict",
        "server_key"
      ],
      "properties": {
        "schema_version": {
          "const": 1
        },
        "profile_name": {
          "type": "string",
          "minLength": 1
        },
        "canonical_codex_home": {
          "type": "string",
          "minLength": 1,
          "pattern": "^/"
        },
        "normalized_argv": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string"
          }
        },
        "launch_cwd_policy": {
          "const": "profile_state_directory_v1"
        },
        "derived_launch_cwd": {
          "type": "string",
          "minLength": 1,
          "pattern": "^/"
        },
        "sanitized_environment": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        },
        "enabled_features": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        },
        "disabled_features": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        },
        "process_static_configuration": {
          "type": "object"
        },
        "initial_configuration_observation": {
          "type": "object"
        },
        "executable_identity": {
          "$ref": "#/$defs/executable_identity"
        },
        "codex_version": {
          "type": "string",
          "minLength": 1
        },
        "schema_bundle_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "compatibility_manifest_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "launch_contract_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "compatibility_verdict": {
          "enum": [
            "tested",
            "unverified",
            "rejected"
          ]
        },
        "server_key": {
          "$ref": "#/$defs/sha256"
        }
      }
    }
  },
  "x-invariants": [
    "server_key and physical generation belong to the launch contract rather than a workspace",
    "snapshot.profile_name records the alias that initiated the generation and is not server identity",
    "membership_revision names the canonical profile-membership/v2 journal revision"
  ]
}
