{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dolgorae.local/schema/interaction-decision/v2",
  "title": "Successor permission and MCP protected decisions",
  "oneOf": [
    {
      "$ref": "#/$defs/permission"
    },
    {
      "$ref": "#/$defs/mcp"
    }
  ],
  "$defs": {
    "permission": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "decision",
        "granted_permissions"
      ],
      "properties": {
        "decision": {
          "enum": [
            "accept_once",
            "decline",
            "cancel"
          ]
        },
        "granted_permissions": {
          "type": "array",
          "uniqueItems": true,
          "maxItems": 64,
          "items": {
            "type": "string",
            "x-maxUtf8Bytes": 4352
          }
        }
      }
    },
    "mcp": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "decision",
        "answers"
      ],
      "properties": {
        "decision": {
          "enum": [
            "accept_once",
            "decline",
            "cancel"
          ]
        },
        "answers": {
          "type": "object",
          "maxProperties": 64,
          "additionalProperties": {
            "type": "string",
            "x-maxUtf8Bytes": 65536
          }
        }
      }
    }
  }
}
