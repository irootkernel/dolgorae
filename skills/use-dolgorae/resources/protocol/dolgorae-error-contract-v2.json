{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dolgorae.local/schema/error-contract/v2",
  "title": "Dolgorae error contract v2",
  "x-exit-status": {
    "LEGACY_STATE_UNSUPPORTED": 5,
    "RUN_MANIFEST_INVALID": 5,
    "STATE_CONFLICT": 4,
    "SESSION_CLOSE_IN_PROGRESS": 4,
    "SPECIALIST_POLICY_DENIED": 4,
    "SPECIALIST_NOT_MEMBER": 4,
    "ENGAGEMENT_NOT_FOUND": 4,
    "ENGAGEMENT_TIMEOUT": 4,
    "ORCHESTRATION_SCHEMA_UNSUPPORTED": 4,
    "SPECIALIST_TASK_NOT_FOUND": 4,
    "SPECIALIST_RESULT_INVALID": 4,
    "REVIEW_PROFILE_UNAVAILABLE": 4,
    "REVIEWER_START_FAILED": 4,
    "REVIEW_TASK_FAILED": 4,
    "REVIEW_INTERRUPTED_UNKNOWN": 4,
    "REVIEW_TIMEOUT": 4,
    "REVIEW_CANCELLED": 4,
    "REVIEW_WORKSPACE_MUTATION_DETECTED": 4,
    "REVIEW_OUTPUT_INVALID": 4,
    "REVIEW_EXECUTABLE_DRIFT": 4,
    "SPECIALIST_WRITER_CONFLICT": 4,
    "ENGAGEMENT_STATE_CONFLICT": 4,
    "REVIEW_TARGET_CARRIER_INVALID": 4,
    "REVIEW_TARGET_CONFLICT": 4,
    "REVIEW_TARGET_FOREIGN_OWNER": 4,
    "REVIEW_TARGET_GIT_FAILED": 4,
    "REVIEW_TARGET_IO_FAILURE": 4,
    "REVIEW_TARGET_LIFECYCLE_MISMATCH": 4,
    "REVIEW_TARGET_LIMIT_EXCEEDED": 4,
    "REVIEW_TARGET_MUTATED": 4,
    "REVIEW_TARGET_REVISION_INVALID": 4,
    "REVIEW_TARGET_SECRET_DETECTED": 4,
    "REVIEW_TARGET_SETTLEMENT_CONCURRENT": 4,
    "REVIEW_TARGET_SETTLEMENT_CONFLICT": 4,
    "REVIEW_TARGET_SOURCE_DRIFT": 4,
    "REVIEW_TARGET_STALE_REVISION": 4,
    "REVIEW_TARGET_STATE_INVALID": 4,
    "REVIEW_TARGET_TERMINAL_EVIDENCE_INVALID": 4,
    "REVIEW_TARGET_TIMEOUT": 4,
    "REVIEW_TARGET_UNSAFE_FILE": 4,
    "REVIEW_TARGET_UNSAFE_PATH": 4,
    "REVIEW_RECOVERY_BLOCKED": 4
  },
  "oneOf": [
    {
      "$ref": "https://dolgorae.local/schema/error-contract/v1"
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": ["code", "message", "retryable", "details"],
      "properties": {
        "code": {"const": "SESSION_CLOSE_IN_PROGRESS"},
        "message": {"type": "string"},
        "retryable": {"const": false},
        "details": {
          "type": "object",
          "additionalProperties": false,
          "required": ["run_id", "operation_id", "required_action"],
          "properties": {
            "run_id": {"type": "string", "format": "uuid"},
            "operation_id": {"type": "string", "format": "uuid"},
            "required_action": {"const": "refresh_snapshot"}
          }
        }
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": ["code", "message", "retryable", "details"],
      "properties": {
        "code": {"const": "RUN_MANIFEST_INVALID"},
        "message": {"type": "string"},
        "retryable": {"const": false},
        "details": {
          "type": "object",
          "additionalProperties": false,
          "required": ["reason"],
          "properties": {"reason": {"type": "string"}}
        }
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "code",
        "message",
        "retryable",
        "details"
      ],
      "properties": {
        "code": {
          "const": "LEGACY_STATE_UNSUPPORTED"
        },
        "message": {
          "type": "string"
        },
        "retryable": {
          "const": false
        },
        "details": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "home",
            "classification"
          ],
          "properties": {
            "home": {
              "type": "string",
              "pattern": "^/"
            },
            "classification": {
              "enum": [
                "uninitialized",
                "unmarked_nonempty",
                "malformed_marker",
                "unsupported_generation",
                "mixed_generation",
                "partial_generation"
              ]
            }
          }
        }
      }
    },
    {
      "$ref": "#/$defs/engagement_error"
    },
    {
      "$ref": "#/$defs/scoped_specialist_review_error"
    },
    {
      "$ref": "#/$defs/review_profile_unavailable_error"
    },
    {
      "$ref": "#/$defs/bare_specialist_review_error"
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "code",
        "message",
        "retryable",
        "details"
      ],
      "properties": {
        "code": {
          "enum": [
            "REVIEW_TARGET_CARRIER_INVALID",
            "REVIEW_TARGET_CONFLICT",
            "REVIEW_TARGET_FOREIGN_OWNER",
            "REVIEW_TARGET_GIT_FAILED",
            "REVIEW_TARGET_LIFECYCLE_MISMATCH",
            "REVIEW_TARGET_LIMIT_EXCEEDED",
            "REVIEW_TARGET_MUTATED",
            "REVIEW_TARGET_REVISION_INVALID",
            "REVIEW_TARGET_SECRET_DETECTED",
            "REVIEW_TARGET_SETTLEMENT_CONCURRENT",
            "REVIEW_TARGET_SETTLEMENT_CONFLICT",
            "REVIEW_TARGET_SOURCE_DRIFT",
            "REVIEW_TARGET_STALE_REVISION",
            "REVIEW_TARGET_STATE_INVALID",
            "REVIEW_TARGET_TERMINAL_EVIDENCE_INVALID",
            "REVIEW_TARGET_TIMEOUT",
            "REVIEW_TARGET_UNSAFE_FILE",
            "REVIEW_TARGET_UNSAFE_PATH"
          ]
        },
        "message": {
          "type": "string"
        },
        "retryable": {
          "const": false
        },
        "details": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "required_action"
          ],
          "properties": {
            "required_action": {
              "const": "none"
            },
            "execution": {
              "$ref": "https://dolgorae.local/schema/review-output-diagnostic/v1#/properties/execution"
            }
          }
        }
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "code",
        "message",
        "retryable",
        "details"
      ],
      "properties": {
        "code": {
          "enum": [
            "REVIEW_TARGET_IO_FAILURE"
          ]
        },
        "message": {
          "type": "string"
        },
        "retryable": {
          "const": false
        },
        "details": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "invariant"
          ],
          "properties": {
            "invariant": {
              "type": "string"
            },
            "execution": {
              "$ref": "https://dolgorae.local/schema/review-output-diagnostic/v1#/properties/execution"
            }
          }
        }
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "code",
        "message",
        "retryable",
        "details"
      ],
      "properties": {
        "code": {
          "const": "REVIEW_RECOVERY_BLOCKED"
        },
        "message": {
          "type": "string"
        },
        "retryable": {
          "const": false
        },
        "details": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "request_ref",
            "reason",
            "required_action"
          ],
          "properties": {
            "request_ref": {
              "type": "string",
              "format": "uuid"
            },
            "reason": {
              "enum": [
                "already_started",
                "operation_active",
                "operation_unknown",
                "authority_unavailable",
                "cleanup_blocked"
              ]
            },
            "required_action": {
              "const": "inspect_original_operation"
            }
          }
        }
      }
    }
  ],
  "$defs": {
    "scoped_specialist_review_error": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "code",
        "message",
        "retryable",
        "details"
      ],
      "properties": {
        "code": {
          "enum": [
            "IDEMPOTENCY_CONFLICT",
            "ENGAGEMENT_TIMEOUT",
            "ENGAGEMENT_STATE_CONFLICT",
            "REVIEW_PROFILE_UNAVAILABLE",
            "REVIEWER_START_FAILED",
            "REVIEW_TASK_FAILED",
            "REVIEW_INTERRUPTED_UNKNOWN",
            "REVIEW_TIMEOUT",
            "REVIEW_CANCELLED",
            "REVIEW_WORKSPACE_MUTATION_DETECTED",
            "REVIEW_OUTPUT_INVALID",
            "REVIEW_EXECUTABLE_DRIFT",
            "REVIEW_TARGET_CARRIER_INVALID",
            "REVIEW_TARGET_CONFLICT",
            "REVIEW_TARGET_FOREIGN_OWNER",
            "REVIEW_TARGET_GIT_FAILED",
            "REVIEW_TARGET_IO_FAILURE",
            "REVIEW_TARGET_LIFECYCLE_MISMATCH",
            "REVIEW_TARGET_LIMIT_EXCEEDED",
            "REVIEW_TARGET_MUTATED",
            "REVIEW_TARGET_REVISION_INVALID",
            "REVIEW_TARGET_SECRET_DETECTED",
            "REVIEW_TARGET_SETTLEMENT_CONCURRENT",
            "REVIEW_TARGET_SETTLEMENT_CONFLICT",
            "REVIEW_TARGET_SOURCE_DRIFT",
            "REVIEW_TARGET_STALE_REVISION",
            "REVIEW_TARGET_STATE_INVALID",
            "REVIEW_TARGET_TERMINAL_EVIDENCE_INVALID",
            "REVIEW_TARGET_TIMEOUT",
            "REVIEW_TARGET_UNSAFE_FILE",
            "REVIEW_TARGET_UNSAFE_PATH"
          ]
        },
        "message": {
          "type": "string"
        },
        "retryable": {
          "type": "boolean"
        },
        "details": {
          "oneOf": [
            {
              "$ref": "https://dolgorae.local/schema/specialist-review-tool/v2#/$defs/error_details"
            },
            {
              "$ref": "https://dolgorae.local/schema/specialist-review-tool/v3#/$defs/error_details"
            }
          ]
        }
      }
    },
    "review_profile_unavailable_error": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "code",
        "message",
        "retryable",
        "details"
      ],
      "properties": {
        "code": {
          "const": "REVIEW_PROFILE_UNAVAILABLE"
        },
        "message": {
          "type": "string"
        },
        "retryable": {
          "const": false
        },
        "details": {
          "oneOf": [
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "profile"
              ],
              "properties": {
                "profile": {
                  "type": "string",
                  "minLength": 1
                }
              }
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "required_action"
              ],
              "properties": {
                "required_action": {
                  "enum": [
                    "none",
                    "remove_dolgorae_review_from_reviewer_profile"
                  ]
                }
              }
            }
          ]
        }
      }
    },
    "bare_specialist_review_error": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "code",
        "message",
        "retryable",
        "details"
      ],
      "properties": {
        "code": {
          "enum": [
            "REVIEWER_START_FAILED",
            "REVIEW_TASK_FAILED",
            "REVIEW_INTERRUPTED_UNKNOWN",
            "REVIEW_TIMEOUT",
            "REVIEW_CANCELLED",
            "REVIEW_WORKSPACE_MUTATION_DETECTED",
            "REVIEW_EXECUTABLE_DRIFT"
          ]
        },
        "message": {
          "type": "string"
        },
        "retryable": {
          "const": false
        },
        "details": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "required_action"
          ],
          "properties": {
            "required_action": {
              "const": "none"
            }
          }
        }
      }
    },
    "engagement_error": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "code",
        "message",
        "retryable",
        "details"
      ],
      "properties": {
        "code": {
          "type": "string"
        },
        "message": {
          "type": "string"
        },
        "retryable": {
          "type": "boolean"
        },
        "details": {
          "type": "object"
        }
      },
      "oneOf": [
        {
          "properties": {
            "code": {
              "const": "IDEMPOTENCY_CONFLICT"
            },
            "details": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "required_action"
              ],
              "properties": {
                "required_action": {
                  "const": "use_original_input_or_new_key"
                }
              }
            },
            "retryable": {
              "const": false
            }
          }
        },
        {
          "properties": {
            "code": {
              "const": "STATE_CONFLICT"
            },
            "details": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "required_action"
              ],
              "properties": {
                "required_action": {
                  "const": "inspect_engagement"
                }
              }
            },
            "retryable": {
              "const": false
            }
          }
        },
        {
          "properties": {
            "code": {
              "const": "SPECIALIST_POLICY_DENIED"
            },
            "details": {
              "oneOf": [
                {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [],
                  "properties": {}
                },
                {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "required_action"
                  ],
                  "properties": {
                    "required_action": {
                      "const": "change_specialist_or_access"
                    }
                  }
                }
              ]
            },
            "retryable": {
              "const": false
            }
          }
        },
        {
          "properties": {
            "code": {
              "const": "SPECIALIST_NOT_MEMBER"
            },
            "details": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "specialist_run_id"
              ],
              "properties": {
                "specialist_run_id": {
                  "$ref": "https://dolgorae.local/schema/error-contract/v1#/$defs/uuid"
                }
              }
            },
            "retryable": {
              "const": false
            }
          }
        },
        {
          "properties": {
            "code": {
              "const": "ENGAGEMENT_NOT_FOUND"
            },
            "details": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "required_action"
              ],
              "properties": {
                "required_action": {
                  "const": "use_existing_engagement"
                }
              }
            },
            "retryable": {
              "const": false
            }
          }
        },
        {
          "properties": {
            "code": {
              "const": "ENGAGEMENT_TIMEOUT"
            },
            "details": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "required_action"
              ],
              "properties": {
                "required_action": {
                  "const": "cancel_or_await_again"
                }
              }
            },
            "retryable": {
              "const": false
            }
          }
        },
        {
          "properties": {
            "code": {
              "const": "ORCHESTRATION_SCHEMA_UNSUPPORTED"
            },
            "details": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "observed"
              ],
              "properties": {
                "observed": {
                  "type": "string"
                }
              }
            },
            "retryable": {
              "const": false
            }
          }
        },
        {
          "properties": {
            "code": {
              "const": "SPECIALIST_TASK_NOT_FOUND"
            },
            "details": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "task_id"
              ],
              "properties": {
                "task_id": {
                  "$ref": "https://dolgorae.local/schema/error-contract/v1#/$defs/uuid"
                }
              }
            },
            "retryable": {
              "const": false
            }
          }
        },
        {
          "properties": {
            "code": {
              "const": "SPECIALIST_RESULT_INVALID"
            },
            "details": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "task_id"
              ],
              "properties": {
                "task_id": {
                  "$ref": "https://dolgorae.local/schema/error-contract/v1#/$defs/uuid"
                }
              }
            },
            "retryable": {
              "const": false
            }
          }
        },
        {
          "properties": {
            "code": {
              "const": "REVIEW_OUTPUT_INVALID"
            },
            "details": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "reason",
                "required_action"
              ],
              "properties": {
                "reason": {
                  "type": "string",
                  "minLength": 1
                },
                "required_action": {
                  "const": "none"
                },
                "diagnostic": {
                  "$ref": "https://dolgorae.local/schema/review-output-diagnostic/v1"
                }
              }
            },
            "retryable": {
              "const": false
            }
          }
        },
        {
          "properties": {
            "code": {
              "const": "SPECIALIST_WRITER_CONFLICT"
            },
            "details": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "cause_code"
              ],
              "properties": {
                "cause_code": {
                  "$ref": "https://dolgorae.local/schema/machine-output/v1#/$defs/error_code"
                }
              }
            }
          }
        },
        {
          "properties": {
            "code": {
              "const": "INTERNAL_ERROR"
            },
            "details": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "reason"
              ],
              "properties": {
                "reason": {
                  "type": "string"
                }
              }
            },
            "retryable": {
              "const": false
            }
          }
        },
        {
          "properties": {
            "code": {
              "const": "ENGAGEMENT_STATE_CONFLICT"
            },
            "details": {
              "oneOf": [
                {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "specialist_run_id"
                  ],
                  "properties": {
                    "specialist_run_id": {
                      "$ref": "https://dolgorae.local/schema/error-contract/v1#/$defs/uuid"
                    }
                  }
                },
                {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "run_id",
                    "engagement_id"
                  ],
                  "properties": {
                    "run_id": {
                      "$ref": "https://dolgorae.local/schema/error-contract/v1#/$defs/uuid"
                    },
                    "engagement_id": {
                      "$ref": "https://dolgorae.local/schema/error-contract/v1#/$defs/uuid"
                    }
                  }
                },
                {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "run_id",
                    "membership_state"
                  ],
                  "properties": {
                    "run_id": {
                      "$ref": "https://dolgorae.local/schema/error-contract/v1#/$defs/uuid"
                    },
                    "membership_state": {
                      "type": "string"
                    }
                  }
                }
              ]
            },
            "retryable": {
              "const": false
            }
          }
        },
        {
          "properties": {
            "code": {
              "const": "RECOVERY_REQUIRED"
            },
            "details": {
              "oneOf": [
                {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "run_id",
                    "required_action"
                  ],
                  "properties": {
                    "run_id": {
                      "$ref": "https://dolgorae.local/schema/error-contract/v1#/$defs/uuid"
                    },
                    "required_action": {
                      "const": "restore_isolated_worktree"
                    }
                  }
                },
                {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "run_id",
                    "lifecycle"
                  ],
                  "properties": {
                    "run_id": {
                      "$ref": "https://dolgorae.local/schema/error-contract/v1#/$defs/uuid"
                    },
                    "lifecycle": {
                      "type": "string"
                    }
                  }
                }
              ]
            },
            "retryable": {
              "const": false
            }
          }
        },
        {
          "properties": {
            "code": {
              "const": "OUTCOME_UNKNOWN"
            },
            "details": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "run_id"
              ],
              "properties": {
                "run_id": {
                  "$ref": "https://dolgorae.local/schema/error-contract/v1#/$defs/uuid"
                }
              }
            },
            "retryable": {
              "const": false
            }
          }
        },
        {
          "properties": {
            "code": {
              "const": "ENGAGEMENT_STATE_CONFLICT"
            },
            "retryable": {
              "const": true
            },
            "details": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "specialist_run_id",
                "required_action"
              ],
              "properties": {
                "specialist_run_id": {
                  "$ref": "https://dolgorae.local/schema/error-contract/v1#/$defs/uuid"
                },
                "required_action": {
                  "const": "retry_after_reconciliation"
                }
              }
            }
          }
        },
        {
          "properties": {
            "code": {
              "const": "OUTCOME_UNKNOWN"
            },
            "details": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "task_id",
                "required_action"
              ],
              "properties": {
                "task_id": {
                  "$ref": "https://dolgorae.local/schema/error-contract/v1#/$defs/uuid"
                },
                "required_action": {
                  "const": "retry_reconciliation"
                }
              }
            }
          }
        }
      ]
    }
  }
}
