{
  "schema_version": 1,
  "name": "scoped_specialist_review_timeout",
  "description": "One Reviewer Turn remains active so bounded wait preserves unknown authority.",
  "codex_home": "/tmp/codex-home",
  "steps": [
    {
      "method": "initialize",
      "respond": {
        "result": {
          "codexHome": "${codex_home}",
          "userAgent": "fake-app-server/1",
          "capabilities": {"experimentalApi": false}
        }
      }
    },
    {"method": "account/read", "respond": {"result": {"requiresOpenaiAuth": false}}},
    {
      "method": "model/list",
      "respond": {
        "result": {
          "data": [
            {
              "model": "gpt-5.6",
              "isDefault": true,
              "supportedReasoningEfforts": [{"reasoningEffort": "medium"}]
            }
          ],
          "nextCursor": null
        }
      }
    },
    {"method": "thread/read", "respond": {"error": {"code": -32600, "message": "thread not found"}}},
    {"method": "thread/start", "respond": {"result": {"thread": {"id": "thread-timeout"}}}},
    {"method": "turn/start", "respond": {"result": {"turn": {"id": "turn-timeout"}}}},
    {
      "method": "turn/interrupt",
      "respond": {"result": {"interrupted": true}},
      "emit": [
        {
          "kind": "notification",
          "method": "turn/completed",
          "params": {
            "threadId": "thread-timeout",
            "turn": {"id": "turn-timeout", "status": "interrupted", "items": []}
          }
        }
      ]
    }
  ]
}
