{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dolgorae.invalid/fake-app-server-scenario-v1.schema.json",
  "title": "Fake app-server scenario v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "name", "steps"],
  "properties": {
    "schema_version": {"const": 1},
    "name": {"type": "string", "minLength": 1, "maxLength": 128},
    "description": {"type": "string", "maxLength": 1024},
    "codex_home": {"type": "string", "minLength": 1},
    "fragment_bytes": {"type": "integer", "minimum": 1},
    "steps": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/step"}
    }
  },
  "$defs": {
    "step": {
      "type": "object",
      "additionalProperties": false,
      "required": ["method"],
      "properties": {
        "method": {"type": "string", "minLength": 1},
        "occurrence": {"type": "integer", "minimum": 1},
        "respond": {"$ref": "#/$defs/respond"},
        "emit": {"type": "array", "items": {"$ref": "#/$defs/emission"}}
      }
    },
    "respond": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "result": {},
        "error": {
          "type": "object",
          "additionalProperties": false,
          "required": ["code", "message"],
          "properties": {
            "code": {"type": "integer"},
            "message": {"type": "string"}
          }
        },
        "generate": {"$ref": "#/$defs/generate"},
        "silent": {"type": "boolean"}
      }
    },
    "generate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind"],
      "properties": {
        "kind": {"enum": ["thread_read"]},
        "decoy_turns": {"type": "integer", "minimum": 0},
        "decoy_filler_bytes": {"type": "integer", "minimum": 0},
        "target_text_bytes": {"type": "integer", "minimum": 0},
        "nest_under_thread": {"type": "boolean"}
      }
    },
    "emission": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind"],
      "properties": {
        "kind": {"enum": ["notification", "request", "close"]},
        "method": {"type": "string", "minLength": 1},
        "id": {"type": "integer", "minimum": 0},
        "params": {},
        "code": {"type": "integer"},
        "await_reply": {"type": "boolean"}
      }
    }
  }
}
