{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dolgorae.local/schema/run-state/v1",
  "title": "Dolgorae execution-lane, policy, writer, and workload state v1",
  "type": "object",
  "additionalProperties": false,
  "x-semanticValidator": "tools/validators/run_state_semantic_validator_v1.py#validate_run_state_v1",
  "required": ["state_variant", "control_mode", "purpose", "execution_lane", "effective_policy", "writer_authority", "server_lane", "workload_background_state", "requested_assurance", "achieved_assurance", "instruction_contract", "lineage"],
  "properties": {
    "state_variant": { "$ref": "#/$defs/state_variant" },
    "control_mode": { "$ref": "#/$defs/control_mode" },
    "purpose": { "$ref": "#/$defs/purpose" },
    "execution_lane": { "$ref": "#/$defs/execution_lane" },
    "effective_policy": { "$ref": "#/$defs/effective_policy" },
    "writer_authority": { "$ref": "#/$defs/writer_authority" },
    "server_lane": { "$ref": "#/$defs/server_lane" },
    "workload_background_state": { "$ref": "#/$defs/workload_background_state" },
    "requested_assurance": { "$ref": "#/$defs/assurance" },
    "achieved_assurance": { "$ref": "#/$defs/assurance" },
    "instruction_contract": { "$ref": "#/$defs/instruction_contract" },
    "lineage": { "oneOf": [{ "$ref": "#/$defs/lineage" }, { "type": "null" }] }
  },
  "allOf": [{ "$ref": "#/$defs/semantic_constraints" }],
  "$defs": {
    "semantic_constraints": {
      "allOf": [
    {
      "if": { "properties": { "execution_lane": { "const": "shared_readonly" } }, "required": ["execution_lane"] },
      "then": { "properties": {
        "state_variant": { "const": "shared_readonly" },
        "effective_policy": { "properties": { "access": { "const": "read" }, "verification": { "const": "verified" }, "writer_generation": { "type": "null" } } },
        "writer_authority": { "properties": { "state": { "const": "none" }, "transaction_id": { "type": "null" } } },
        "server_lane": { "properties": { "kind": { "const": "shared_readonly" }, "lane_id": { "type": "null" } } },
        "workload_background_state": { "properties": { "mechanism": { "const": "shared_profile_aggregate" } } }
      } }
    },
    {
      "if": { "properties": { "state_variant": { "const": "dedicated_unstarted" } }, "required": ["state_variant"] },
      "then": { "properties": {
        "execution_lane": { "const": "dedicated" },
        "effective_policy": { "properties": { "access": { "enum": ["read", "unknown"] }, "server_epoch": { "type": "null" }, "writer_generation": { "type": "null" } } },
        "writer_authority": { "properties": { "state": { "const": "none" } } },
        "server_lane": { "properties": { "kind": { "const": "dedicated" }, "state": { "const": "absent" }, "process_generation": { "type": "null" }, "server_epoch": { "type": "null" }, "socket_identity_sha256": { "type": "null" } } }
      } }
    },
    {
      "if": { "properties": { "writer_authority": { "properties": { "state": { "const": "active" } }, "required": ["state"] } } },
      "then": { "properties": {
        "state_variant": { "const": "dedicated_writer_active" },
        "execution_lane": { "const": "dedicated" },
        "effective_policy": { "properties": { "access": { "const": "write" }, "verification": { "const": "verified" }, "server_epoch": { "type": "integer" }, "writer_generation": { "type": "integer" } } },
        "server_lane": { "properties": { "kind": { "const": "dedicated" }, "state": { "const": "ready" }, "server_epoch": { "type": "integer" } } }
      } }
    },
    {
      "if": { "properties": { "effective_policy": { "properties": { "access": { "const": "write" } }, "required": ["access"] } } },
      "then": { "properties": { "writer_authority": { "properties": { "state": { "const": "active" } } } } }
    },
    {
      "if": { "properties": { "state_variant": { "const": "dedicated_reader" } }, "required": ["state_variant"] },
      "then": { "properties": {
        "execution_lane": { "const": "dedicated" },
        "effective_policy": { "properties": { "access": { "const": "read" }, "verification": { "const": "verified" }, "server_epoch": { "type": "integer" }, "writer_generation": { "type": "null" } } },
        "writer_authority": { "properties": { "state": { "const": "none" }, "transaction_id": { "type": "null" } } },
        "server_lane": { "properties": { "kind": { "const": "dedicated" }, "state": { "const": "ready" }, "server_epoch": { "type": "integer" } } }
      } }
    },
    {
      "if": { "properties": { "state_variant": { "const": "dedicated_writer_reserved" } }, "required": ["state_variant"] },
      "then": { "properties": {
        "execution_lane": { "const": "dedicated" },
        "effective_policy": { "not": { "properties": { "access": { "const": "write" }, "verification": { "const": "verified" } }, "required": ["access", "verification"] } },
        "writer_authority": { "properties": { "state": { "const": "reserved" }, "writer_generation": { "type": "integer", "minimum": 1 }, "transaction_id": { "$ref": "#/$defs/uuid" } } }
      } }
    },
    {
      "if": { "properties": { "state_variant": { "const": "dedicated_writer_active" } }, "required": ["state_variant"] },
      "then": { "properties": {
        "execution_lane": { "const": "dedicated" },
        "effective_policy": { "properties": { "access": { "const": "write" }, "verification": { "const": "verified" }, "server_epoch": { "type": "integer" }, "writer_generation": { "type": "integer" } } },
        "writer_authority": { "properties": { "state": { "const": "active" }, "writer_generation": { "type": "integer", "minimum": 1 } } },
        "server_lane": { "properties": { "kind": { "const": "dedicated" }, "state": { "const": "ready" }, "server_epoch": { "type": "integer" } } }
      } }
    },
    {
      "if": { "properties": { "state_variant": { "const": "dedicated_releasing" } }, "required": ["state_variant"] },
      "then": { "properties": {
        "execution_lane": { "const": "dedicated" },
        "effective_policy": { "properties": { "access": { "enum": ["write", "transitioning", "unknown"] } } },
        "writer_authority": { "properties": { "state": { "const": "releasing" }, "writer_generation": { "type": "integer", "minimum": 1 }, "transaction_id": { "$ref": "#/$defs/uuid" } } }
      } }
    },
    {
      "if": { "properties": { "state_variant": { "const": "dedicated_blocked_unknown" } }, "required": ["state_variant"] },
      "then": { "properties": {
        "execution_lane": { "const": "dedicated" },
        "writer_authority": { "properties": { "state": { "const": "blocked_unknown" }, "reconciliation_action": { "type": "string" } } }
      } }
    },
    {
      "if": { "properties": { "state_variant": { "enum": ["dedicated_paused", "dedicated_generation_failed"] } }, "required": ["state_variant"] },
      "then": { "properties": {
        "execution_lane": { "const": "dedicated" },
        "effective_policy": { "not": { "properties": { "access": { "const": "write" }, "verification": { "const": "verified" } }, "required": ["access", "verification"] } },
        "writer_authority": { "properties": { "state": { "const": "none" } } }
      } }
    }
  ]
    },
    "uuid": { "type": "string", "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$" },
    "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "control_mode": { "enum": ["direct_interactive", "managed_agent"] },
    "purpose": { "type": "object", "additionalProperties": false, "required": ["kind", "external_label"], "properties": { "kind": { "enum": ["interactive", "planning", "implementation", "review", "research", "discussion", "workflow_stage", "other"] }, "external_label": { "type": ["string", "null"], "pattern": "^[^\\u0000-\\u001f\\u007f]+$", "x-maxUtf8Bytes": 128 } } },
    "execution_lane": { "enum": ["shared_readonly", "dedicated"] },
    "state_variant": { "enum": ["shared_readonly", "dedicated_unstarted", "dedicated_reader", "dedicated_writer_reserved", "dedicated_writer_active", "dedicated_releasing", "dedicated_blocked_unknown", "dedicated_paused", "dedicated_generation_failed"] },
    "assurance": { "enum": ["best_effort_personal_alpha", "verified_thread_scoped_control", "strong_process_containment"] },
    "effective_policy": {
      "type": "object", "additionalProperties": false,
      "required": ["access", "verification", "policy_epoch", "thread_generation", "server_epoch", "writer_generation"],
      "properties": {
        "access": { "enum": ["read", "write", "transitioning", "unsupported", "unknown"] },
        "verification": { "enum": ["verified", "unverified", "failed"] },
        "policy_epoch": { "type": "integer", "minimum": 0 },
        "thread_generation": { "type": "integer", "minimum": 0 },
        "server_epoch": { "type": ["integer", "null"], "minimum": 1 },
        "writer_generation": { "type": ["integer", "null"], "minimum": 1 }
      }
    },
    "writer_authority": {
      "type": "object", "additionalProperties": false,
      "required": ["state", "writer_generation", "transaction_id", "reconciliation_action"],
      "properties": {
        "state": { "enum": ["none", "reserved", "active", "releasing", "blocked_unknown"] },
        "writer_generation": { "type": "integer", "minimum": 0 },
        "transaction_id": { "oneOf": [{ "$ref": "#/$defs/uuid" }, { "type": "null" }] },
        "reconciliation_action": { "type": ["string", "null"], "enum": ["retry_census", "reconcile_dedicated_lane", "operator_repair", "reverify_writer_policy", null] }
      }
    },
    "server_lane": {
      "type": "object", "additionalProperties": false,
      "required": ["kind", "lane_id", "process_generation", "server_epoch", "state", "socket_identity_sha256"],
      "properties": {
        "kind": { "$ref": "#/$defs/execution_lane" },
        "lane_id": { "oneOf": [{ "$ref": "#/$defs/uuid" }, { "type": "null" }] },
        "process_generation": { "type": ["integer", "null"], "minimum": 1 },
        "server_epoch": { "type": ["integer", "null"], "minimum": 1 },
        "state": { "enum": ["starting", "ready", "stopping", "absent", "unverified", "failed"] },
        "socket_identity_sha256": { "type": ["string", "null"], "pattern": "^[0-9a-f]{64}$" }
      }
    },
    "workload_background_state": {
      "type": "object", "additionalProperties": false,
      "required": ["state", "mechanism", "census_revision", "observed_process_count", "quiescent_since", "consecutive_empty_samples"],
      "properties": {
        "state": { "enum": ["verified_absent", "active", "unverified", "not_applicable"] },
        "mechanism": { "enum": ["dedicated_lane_process_census", "hybrid", "shared_profile_aggregate"] },
        "census_revision": { "type": "integer", "minimum": 0 },
        "observed_process_count": { "type": "integer", "minimum": 0 },
        "quiescent_since": { "type": ["string", "null"], "format": "date-time" },
        "consecutive_empty_samples": { "type": "integer", "minimum": 0, "maximum": 5 }
      },
      "allOf": [{ "if": { "properties": { "state": { "const": "verified_absent" } } }, "then": { "properties": { "observed_process_count": { "const": 0 }, "quiescent_since": { "type": "string" }, "consecutive_empty_samples": { "const": 5 } } } }]
    },
    "instruction_contract": { "type": "object", "additionalProperties": false, "required": ["schema", "common_prefix_version", "mode_prefix_version", "purpose_prefix_version"], "properties": { "schema": { "const": "dolgorae.instructions/v1" }, "common_prefix_version": { "const": 1 }, "mode_prefix_version": { "const": 1 }, "purpose_prefix_version": { "const": 1 } } },
    "lineage": { "type": "object", "additionalProperties": false, "required": ["source_run_id", "source_turn_id", "source_thread_id", "creation_reason", "source_controller_kind", "destination_controller_kind", "handoff_summary_sha256", "artifact_refs", "workspace_baseline_sha256", "created_at"], "properties": { "source_run_id": { "$ref": "#/$defs/uuid" }, "source_turn_id": { "type": "string", "minLength": 1 }, "source_thread_id": { "type": "string", "minLength": 1 }, "creation_reason": { "enum": ["shared_readonly_source", "access_transition_unavailable", "access_transition_unverified"] }, "source_controller_kind": { "enum": ["human_cli", "interactive_client", "workflow_orchestrator", "automation"] }, "destination_controller_kind": { "enum": ["human_cli", "interactive_client", "workflow_orchestrator", "automation"] }, "handoff_summary_sha256": { "oneOf": [{ "$ref": "#/$defs/sha256" }, { "type": "null" }] }, "artifact_refs": { "type": "array", "maxItems": 64, "uniqueItems": true, "items": { "$ref": "#/$defs/uuid" } }, "workspace_baseline_sha256": { "$ref": "#/$defs/sha256" }, "created_at": { "type": "string", "format": "date-time" } } }
  }
}
