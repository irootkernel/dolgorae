{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dolgorae.local/schema/successor-state/v1",
  "title": "Dolgorae individually versioned successor state selection",
  "oneOf": [
    {
      "$ref": "https://dolgorae.local/schema/successor-state/v1#/$defs/instruction_snapshot"
    },
    {
      "$ref": "https://dolgorae.local/schema/successor-state/v1#/$defs/agent_configuration"
    },
    {
      "$ref": "https://dolgorae.local/schema/successor-state/v1#/$defs/modern_run_manifest"
    },
    {
      "$ref": "https://dolgorae.local/schema/successor-state/v1#/$defs/run_state"
    },
    {
      "$ref": "https://dolgorae.local/schema/successor-state/v1#/$defs/operation_intent"
    },
    {
      "$ref": "https://dolgorae.local/schema/successor-state/v1#/$defs/protected_invocation"
    },
    {
      "$ref": "https://dolgorae.local/schema/successor-state/v1#/$defs/group_record"
    },
    {
      "$ref": "https://dolgorae.local/schema/successor-state/v1#/$defs/merge_record"
    },
    {
      "$ref": "https://dolgorae.local/schema/successor-state/v1#/$defs/pool_configuration"
    },
    {
      "$ref": "https://dolgorae.local/schema/successor-state/v1#/$defs/pool_state"
    },
    {
      "$ref": "https://dolgorae.local/schema/successor-state/v1#/$defs/queue_state"
    },
    {
      "$ref": "https://dolgorae.local/schema/successor-state/v1#/$defs/lifecycle_state"
    },
    {
      "$ref": "https://dolgorae.local/schema/successor-state/v1#/$defs/generation_manifest"
    },
    {
      "$ref": "https://dolgorae.local/schema/successor-state/v1#/$defs/maintenance_state"
    },
    {
      "$ref": "https://dolgorae.local/schema/successor-state/v1#/$defs/content_tombstone"
    }
  ],
  "$defs": {
    "captured_named_source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "source"
      ],
      "properties": {
        "name": {
          "$ref": "https://dolgorae.local/schema/v014-identities/v1#/$defs/alias"
        },
        "source": {
          "$ref": "https://dolgorae.local/schema/workspace-execution/v1#/$defs/source_capture"
        }
      }
    },
    "instruction_snapshot": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema",
        "core_prefix_version",
        "core_prefix_sha256",
        "common",
        "role",
        "composition_sha256",
        "dependencies",
        "selected_guidance",
        "role_snapshot",
        "role_snapshot_digest",
        "instruction_identity",
        "instruction_identity_digest"
      ],
      "properties": {
        "schema": {
          "const": "dolgorae.instructions/v3"
        },
        "core_prefix_version": {
          "const": 2
        },
        "core_prefix_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "common": {
          "$ref": "https://dolgorae.local/schema/workspace-execution/v1#/$defs/source_capture"
        },
        "role": {
          "$ref": "https://dolgorae.local/schema/workspace-execution/v1#/$defs/role_capture"
        },
        "composition_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "dependencies": {
          "type": "array",
          "items": {
            "$ref": "https://dolgorae.local/schema/successor-state/v1#/$defs/captured_named_source"
          },
          "minItems": 0,
          "maxItems": 64
        },
        "selected_guidance": {
          "type": "array",
          "items": {
            "$ref": "https://dolgorae.local/schema/successor-state/v1#/$defs/captured_named_source"
          },
          "minItems": 0,
          "maxItems": 64
        },
        "role_snapshot": {
          "$ref": "https://dolgorae.local/schema/v014-identities/v1#/$defs/role_snapshot"
        },
        "role_snapshot_digest": {
          "$ref": "https://dolgorae.local/schema/v014-identities/v1#/$defs/digest"
        },
        "instruction_identity": {
          "$ref": "https://dolgorae.local/schema/v014-identities/v1#/$defs/instruction_identity"
        },
        "instruction_identity_digest": {
          "$ref": "https://dolgorae.local/schema/v014-identities/v1#/$defs/digest"
        }
      },
      "x-invariants": [
        "Accepted common/Role/dependency/guidance bodies and hashes match the complete closed identities; aggregate UTF-8 bytes≤65536, excluding core and separators.",
        "Source aliases/order/composition follow instruction-identity/v1. Recovery reconstructs only accepted bytes; no source reloading or in-place legacy rewrite."
      ]
    },
    "agent_configuration": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "selected_profile",
        "global_profile_binding_sha256",
        "model",
        "default_effort",
        "purpose",
        "required_capabilities",
        "role_reference",
        "instructions",
        "execution_lane",
        "required_assurance",
        "native_subagent_policy",
        "requested_access",
        "admitted_configuration",
        "agent_configuration_digest"
      ],
      "properties": {
        "schema_version": {
          "const": 4
        },
        "selected_profile": {
          "$ref": "https://dolgorae.local/schema/agent-configuration/v2#/properties/selected_profile"
        },
        "global_profile_binding_sha256": {
          "$ref": "https://dolgorae.local/schema/agent-configuration/v2#/properties/global_profile_binding_sha256"
        },
        "model": {
          "$ref": "https://dolgorae.local/schema/agent-configuration/v2#/properties/model"
        },
        "default_effort": {
          "$ref": "https://dolgorae.local/schema/agent-configuration/v2#/properties/default_effort"
        },
        "purpose": {
          "$ref": "https://dolgorae.local/schema/agent-configuration/v2#/properties/purpose"
        },
        "required_capabilities": {
          "$ref": "https://dolgorae.local/schema/agent-configuration/v2#/properties/required_capabilities"
        },
        "role_reference": {
          "$ref": "https://dolgorae.local/schema/agent-configuration/v2#/properties/role_reference"
        },
        "instructions": {
          "$ref": "https://dolgorae.local/schema/successor-state/v1#/$defs/instruction_snapshot"
        },
        "execution_lane": {
          "enum": [
            "dedicated",
            "shared_readonly"
          ]
        },
        "required_assurance": {
          "$ref": "https://dolgorae.local/schema/agent-configuration/v2#/properties/required_assurance"
        },
        "native_subagent_policy": {
          "enum": [
            "enabled",
            "disabled"
          ]
        },
        "requested_access": {
          "enum": [
            "read_only",
            "canonical_workspace_write"
          ]
        },
        "admitted_configuration": {
          "$ref": "https://dolgorae.local/schema/v014-identities/v1#/$defs/admitted_configuration"
        },
        "agent_configuration_digest": {
          "$ref": "https://dolgorae.local/schema/v014-identities/v1#/$defs/digest"
        }
      },
      "x-invariants": [
        "Retained Profile binding and captured instructions match admitted_configuration. Its digest is immutable; later default effort applies to future task admissions.",
        "Current writer/verification facts never enter admitted configuration identity."
      ],
      "allOf": [
        {
          "if": {
            "properties": {
              "execution_lane": {
                "const": "shared_readonly"
              }
            }
          },
          "then": {
            "properties": {
              "requested_access": {
                "const": "read_only"
              },
              "native_subagent_policy": {
                "const": "disabled"
              }
            }
          }
        }
      ]
    },
    "modern_run_manifest": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "run_id",
        "workspace_id",
        "canonical_workspace",
        "workspace_mode",
        "start_baseline",
        "created_at",
        "initial_access",
        "control_mode",
        "execution_lane",
        "requested_assurance",
        "achieved_assurance",
        "profile",
        "global_profile_binding",
        "agent_configuration",
        "profile_capability_snapshot",
        "app_server",
        "dolgorae",
        "model",
        "initial_reasoning_effort",
        "default_reasoning_effort",
        "instructions",
        "controller",
        "purpose",
        "parent_ref",
        "required_capabilities",
        "thread_id",
        "fork_provenance",
        "write_continuation_provenance",
        "aggregate_binding",
        "audit",
        "compatibility",
        "requested_access",
        "selected_role",
        "start_contract",
        "creation_mode",
        "admitted_configuration_digest",
        "start_operation_receipt"
      ],
      "properties": {
        "schema_version": {
          "const": 4
        },
        "run_id": {
          "$ref": "https://dolgorae.local/schema/run-manifest/v2#/properties/run_id"
        },
        "workspace_id": {
          "$ref": "https://dolgorae.local/schema/run-manifest/v2#/properties/workspace_id"
        },
        "canonical_workspace": {
          "$ref": "https://dolgorae.local/schema/run-manifest/v2#/properties/canonical_workspace"
        },
        "workspace_mode": {
          "$ref": "https://dolgorae.local/schema/run-manifest/v2#/properties/workspace_mode"
        },
        "start_baseline": {
          "$ref": "https://dolgorae.local/schema/run-manifest/v2#/properties/start_baseline"
        },
        "created_at": {
          "$ref": "https://dolgorae.local/schema/run-manifest/v2#/properties/created_at"
        },
        "initial_access": {
          "$ref": "https://dolgorae.local/schema/run-manifest/v2#/properties/initial_access"
        },
        "control_mode": {
          "$ref": "https://dolgorae.local/schema/run-manifest/v2#/properties/control_mode"
        },
        "execution_lane": {
          "enum": [
            "dedicated",
            "shared_readonly"
          ]
        },
        "requested_assurance": {
          "$ref": "https://dolgorae.local/schema/run-manifest/v2#/properties/requested_assurance"
        },
        "achieved_assurance": {
          "$ref": "https://dolgorae.local/schema/run-manifest/v2#/properties/achieved_assurance"
        },
        "profile": {
          "$ref": "https://dolgorae.local/schema/run-manifest/v2#/properties/profile"
        },
        "global_profile_binding": {
          "$ref": "https://dolgorae.local/schema/run-manifest/v2#/properties/global_profile_binding"
        },
        "agent_configuration": {
          "$ref": "https://dolgorae.local/schema/successor-state/v1#/$defs/agent_configuration"
        },
        "profile_capability_snapshot": {
          "$ref": "https://dolgorae.local/schema/run-manifest/v2#/properties/profile_capability_snapshot"
        },
        "app_server": {
          "$ref": "https://dolgorae.local/schema/run-manifest/v2#/properties/app_server"
        },
        "dolgorae": {
          "$ref": "https://dolgorae.local/schema/run-manifest/v2#/properties/dolgorae"
        },
        "model": {
          "$ref": "https://dolgorae.local/schema/run-manifest/v2#/properties/model"
        },
        "initial_reasoning_effort": {
          "$ref": "https://dolgorae.local/schema/run-manifest/v2#/properties/initial_reasoning_effort"
        },
        "default_reasoning_effort": {
          "$ref": "https://dolgorae.local/schema/run-manifest/v2#/properties/default_reasoning_effort"
        },
        "instructions": {
          "$ref": "https://dolgorae.local/schema/successor-state/v1#/$defs/instruction_snapshot"
        },
        "controller": {
          "$ref": "https://dolgorae.local/schema/run-manifest/v2#/properties/controller"
        },
        "purpose": {
          "$ref": "https://dolgorae.local/schema/run-manifest/v2#/properties/purpose"
        },
        "parent_ref": {
          "$ref": "https://dolgorae.local/schema/run-manifest/v2#/properties/parent_ref"
        },
        "required_capabilities": {
          "$ref": "https://dolgorae.local/schema/run-manifest/v2#/properties/required_capabilities"
        },
        "thread_id": {
          "$ref": "https://dolgorae.local/schema/run-manifest/v2#/properties/thread_id"
        },
        "fork_provenance": {
          "$ref": "https://dolgorae.local/schema/run-manifest/v2#/properties/fork_provenance"
        },
        "write_continuation_provenance": {
          "$ref": "https://dolgorae.local/schema/run-manifest/v2#/properties/write_continuation_provenance"
        },
        "aggregate_binding": {
          "$ref": "https://dolgorae.local/schema/run-manifest/v2#/properties/aggregate_binding"
        },
        "audit": {
          "$ref": "https://dolgorae.local/schema/run-manifest/v2#/properties/audit"
        },
        "compatibility": {
          "$ref": "https://dolgorae.local/schema/run-manifest/v2#/properties/compatibility"
        },
        "requested_access": {
          "enum": [
            "read-only",
            "writable"
          ]
        },
        "selected_role": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9._-]{0,63}$",
          "maxLength": 64
        },
        "start_contract": {
          "const": "caller_workspace/v1"
        },
        "creation_mode": {
          "enum": [
            "read_only",
            "writable"
          ]
        },
        "admitted_configuration_digest": {
          "$ref": "https://dolgorae.local/schema/v014-identities/v1#/$defs/digest"
        },
        "start_operation_receipt": {
          "anyOf": [
            {
              "$ref": "https://dolgorae.local/schema/v014-identities/v1#/$defs/operation_receipt"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "x-invariants": [
        "Retained base manifest provenance fields retain their original meaning. creation_mode is immutable selection, distinct from current effective access and writer authority.",
        "Accepted configuration/instructions and digest fields agree. Fixed shared_readonly creation cannot acquire write authority. Existing manifest/v3 remains readable and is not rewritten."
      ]
    },
    "run_state": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "state_variant",
        "control_mode",
        "purpose",
        "execution_lane",
        "effective_policy",
        "writer_authority",
        "server_lane",
        "workload_background_state",
        "requested_assurance",
        "achieved_assurance",
        "instruction_contract",
        "lineage",
        "creation_mode",
        "admitted_configuration_digest",
        "queue_revision",
        "pool_lease_ref",
        "lifecycle_operation_ref",
        "schema_version"
      ],
      "properties": {
        "state_variant": {
          "$ref": "https://dolgorae.local/schema/run-state/v1#/$defs/state_variant"
        },
        "control_mode": {
          "$ref": "https://dolgorae.local/schema/run-state/v1#/$defs/control_mode"
        },
        "purpose": {
          "$ref": "https://dolgorae.local/schema/run-state/v1#/$defs/purpose"
        },
        "execution_lane": {
          "$ref": "https://dolgorae.local/schema/run-state/v1#/$defs/execution_lane"
        },
        "effective_policy": {
          "$ref": "https://dolgorae.local/schema/run-state/v1#/$defs/effective_policy"
        },
        "writer_authority": {
          "$ref": "https://dolgorae.local/schema/run-state/v1#/$defs/writer_authority"
        },
        "server_lane": {
          "$ref": "https://dolgorae.local/schema/run-state/v1#/$defs/server_lane"
        },
        "workload_background_state": {
          "$ref": "https://dolgorae.local/schema/run-state/v1#/$defs/workload_background_state"
        },
        "requested_assurance": {
          "$ref": "https://dolgorae.local/schema/run-state/v1#/$defs/assurance"
        },
        "achieved_assurance": {
          "$ref": "https://dolgorae.local/schema/run-state/v1#/$defs/assurance"
        },
        "instruction_contract": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "schema",
            "core_prefix_version",
            "instruction_identity_digest"
          ],
          "properties": {
            "schema": {
              "const": "dolgorae.instructions/v3"
            },
            "core_prefix_version": {
              "const": 2
            },
            "instruction_identity_digest": {
              "$ref": "https://dolgorae.local/schema/v014-identities/v1#/$defs/digest"
            }
          }
        },
        "lineage": {
          "oneOf": [
            {
              "$ref": "https://dolgorae.local/schema/run-state/v1#/$defs/lineage"
            },
            {
              "type": "null"
            }
          ]
        },
        "creation_mode": {
          "enum": [
            "read_only",
            "writable"
          ]
        },
        "admitted_configuration_digest": {
          "$ref": "https://dolgorae.local/schema/v014-identities/v1#/$defs/digest"
        },
        "queue_revision": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "pool_lease_ref": {
          "anyOf": [
            {
              "$ref": "https://dolgorae.local/schema/v014-identities/v1#/$defs/opaque_ref"
            },
            {
              "type": "null"
            }
          ]
        },
        "lifecycle_operation_ref": {
          "anyOf": [
            {
              "$ref": "https://dolgorae.local/schema/v014-identities/v1#/$defs/uuid7"
            },
            {
              "type": "null"
            }
          ]
        },
        "schema_version": {
          "const": 2
        }
      },
      "allOf": [
        {
          "$ref": "https://dolgorae.local/schema/run-state/v1#/$defs/semantic_constraints"
        }
      ]
    },
    "operation_intent": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "operation_ref",
        "mutation_envelope",
        "mutation_envelope_digest",
        "expected_revision",
        "trusted_invocation",
        "state",
        "accepted_subjects",
        "receipt",
        "definitive_refusal"
      ],
      "properties": {
        "schema_version": {
          "const": 2
        },
        "operation_ref": {
          "$ref": "https://dolgorae.local/schema/v014-identities/v1#/$defs/uuid7"
        },
        "mutation_envelope": {
          "$ref": "https://dolgorae.local/schema/v014-identities/v1#/$defs/mutation_envelope"
        },
        "mutation_envelope_digest": {
          "$ref": "https://dolgorae.local/schema/v014-identities/v1#/$defs/digest"
        },
        "expected_revision": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            {
              "type": "null"
            }
          ]
        },
        "trusted_invocation": {
          "anyOf": [
            {
              "$ref": "https://dolgorae.local/schema/v014-identities/v1#/$defs/trusted_invocation_context"
            },
            {
              "type": "null"
            }
          ]
        },
        "state": {
          "enum": [
            "prepared",
            "accepted",
            "resolved_not_accepted",
            "unresolved"
          ]
        },
        "accepted_subjects": {
          "$ref": "https://dolgorae.local/schema/v014-identities/v1#/$defs/accepted_subjects"
        },
        "receipt": {
          "anyOf": [
            {
              "$ref": "https://dolgorae.local/schema/v014-identities/v1#/$defs/operation_receipt"
            },
            {
              "type": "null"
            }
          ]
        },
        "definitive_refusal": {
          "anyOf": [
            {
              "$ref": "https://dolgorae.local/schema/v014-identities/v1#/$defs/safe_code"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "state": {
                "const": "accepted"
              }
            }
          },
          "then": {
            "properties": {
              "receipt": {
                "$ref": "https://dolgorae.local/schema/v014-identities/v1#/$defs/operation_receipt"
              },
              "definitive_refusal": {
                "const": null
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "state": {
                "const": "resolved_not_accepted"
              }
            }
          },
          "then": {
            "properties": {
              "receipt": {
                "const": null
              },
              "definitive_refusal": {
                "$ref": "https://dolgorae.local/schema/v014-identities/v1#/$defs/safe_code"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "state": {
                "enum": [
                  "prepared",
                  "unresolved"
                ]
              }
            }
          },
          "then": {
            "properties": {
              "receipt": {
                "const": null
              },
              "definitive_refusal": {
                "const": null
              }
            }
          }
        }
      ],
      "x-invariants": [
        "Intent precedes effect; receipt and accepted identity commit before acknowledgement. Same accepted key replays original receipt before testing expected revision. No deadline or content retirement deletes retained operation identity."
      ]
    },
    "protected_invocation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema",
        "context",
        "namespace",
        "native_session_ref",
        "native_turn_ref",
        "native_tool_use_ref",
        "opaque_binding_secret_digest",
        "state",
        "operation_ref",
        "receipt"
      ],
      "properties": {
        "schema": {
          "const": "dolgorae.protected-invocation-state/v1"
        },
        "context": {
          "$ref": "https://dolgorae.local/schema/v014-identities/v1#/$defs/trusted_invocation_context"
        },
        "namespace": {
          "$ref": "https://dolgorae.local/schema/v014-identities/v1#/$defs/lookup_namespace"
        },
        "native_session_ref": {
          "$ref": "https://dolgorae.local/schema/v014-identities/v1#/$defs/opaque_ref"
        },
        "native_turn_ref": {
          "anyOf": [
            {
              "$ref": "https://dolgorae.local/schema/v014-identities/v1#/$defs/opaque_ref"
            },
            {
              "type": "null"
            }
          ]
        },
        "native_tool_use_ref": {
          "$ref": "https://dolgorae.local/schema/v014-identities/v1#/$defs/opaque_ref"
        },
        "opaque_binding_secret_digest": {
          "$ref": "https://dolgorae.local/schema/v014-identities/v1#/$defs/digest"
        },
