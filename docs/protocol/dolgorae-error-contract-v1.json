{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dolgorae.local/schema/error-contract/v1",
  "title": "Dolgorae error contract v1",
  "x-exit-status": {
    "INVALID_ARGUMENT": 2,
    "WORKSPACE_NOT_INITIALIZED": 3, "CONFIG_INVALID": 3,
    "PROFILE_CONFIG_INVALID": 3, "PROFILE_NOT_FOUND": 3,
    "RUN_NOT_FOUND": 3, "THREAD_NOT_FOUND": 3, "TURN_NOT_FOUND": 3,
    "REQUEST_NOT_FOUND": 3,
    "PROFILE_ALREADY_EXISTS": 4, "PROFILE_SERVER_BUSY": 4,
    "WORKSPACE_INITIALIZATION_CONFLICT": 4,
    "RUN_STATE_CONFLICT": 4, "POLICY_REJECTED": 4, "RUN_BUSY": 4,
    "WRITER_BUSY": 4, "IDEMPOTENCY_CONFLICT": 4, "STALE_REQUEST": 4,
    "OUTCOME_UNKNOWN": 4, "RECOVERY_REQUIRED": 4,
    "PROFILE_MISMATCH": 5, "COMPATIBILITY_REJECTED": 5,
    "DOLGORAE_PROTOCOL_MISMATCH": 5,
    "TRANSPORT_FAILURE": 6, "OPERATION_TIMEOUT": 6, "PROTOCOL_FRAME_TOO_LARGE": 6,
    "RUNTIME_PATH_INVALID": 6, "RUNTIME_PATH_COLLISION": 6,
    "REDACTION_FAILURE": 6, "INTERNAL_ERROR": 6,
    "TURN_FAILED": 7, "TURN_INTERRUPTED": 7,
    "AUDIT_INTEGRITY_FAILURE": 8
  },
  "type": "object",
  "additionalProperties": false,
  "required": ["code", "message", "retryable", "details"],
  "properties": {
    "code": { "$ref": "#/$defs/error_code" },
    "message": { "type": "string" },
    "retryable": { "type": "boolean" },
    "details": { "type": "object" }
  },
  "oneOf": [
    { "$ref": "#/$defs/invalid_argument" },
    { "$ref": "#/$defs/workspace_not_initialized" },
    { "$ref": "#/$defs/config_invalid" },
    { "$ref": "#/$defs/profile_config_invalid" },
    { "$ref": "#/$defs/profile_not_found" },
    { "$ref": "#/$defs/run_not_found" },
    { "$ref": "#/$defs/thread_not_found" },
    { "$ref": "#/$defs/turn_not_found" },
    { "$ref": "#/$defs/request_not_found" },
    { "$ref": "#/$defs/profile_already_exists" },
    { "$ref": "#/$defs/profile_server_busy" },
    { "$ref": "#/$defs/workspace_initialization_conflict" },
    { "$ref": "#/$defs/run_state_conflict" },
    { "$ref": "#/$defs/policy_rejected" },
    { "$ref": "#/$defs/run_busy" },
    { "$ref": "#/$defs/writer_busy" },
    { "$ref": "#/$defs/idempotency_conflict" },
    { "$ref": "#/$defs/stale_request" },
    { "$ref": "#/$defs/outcome_unknown" },
    { "$ref": "#/$defs/recovery_required" },
    { "$ref": "#/$defs/profile_mismatch" },
    { "$ref": "#/$defs/compatibility_rejected" },
    { "$ref": "#/$defs/dolgorae_protocol_mismatch" },
    { "$ref": "#/$defs/transport_retryable" },
    { "$ref": "#/$defs/transport_not_retryable" },
    { "$ref": "#/$defs/operation_timeout" },
    { "$ref": "#/$defs/protocol_frame_too_large" },
    { "$ref": "#/$defs/runtime_path_invalid" },
    { "$ref": "#/$defs/runtime_path_collision" },
    { "$ref": "#/$defs/redaction_failure" },
    { "$ref": "#/$defs/internal_error" },
    { "$ref": "#/$defs/turn_failed" },
    { "$ref": "#/$defs/turn_interrupted" },
    { "$ref": "#/$defs/audit_integrity_failure" }
  ],
  "$defs": {
    "error_code": { "enum": ["INVALID_ARGUMENT", "WORKSPACE_NOT_INITIALIZED", "CONFIG_INVALID", "PROFILE_CONFIG_INVALID", "PROFILE_NOT_FOUND", "RUN_NOT_FOUND", "THREAD_NOT_FOUND", "TURN_NOT_FOUND", "REQUEST_NOT_FOUND", "PROFILE_ALREADY_EXISTS", "PROFILE_SERVER_BUSY", "WORKSPACE_INITIALIZATION_CONFLICT", "RUN_STATE_CONFLICT", "POLICY_REJECTED", "RUN_BUSY", "WRITER_BUSY", "IDEMPOTENCY_CONFLICT", "STALE_REQUEST", "OUTCOME_UNKNOWN", "RECOVERY_REQUIRED", "PROFILE_MISMATCH", "COMPATIBILITY_REJECTED", "DOLGORAE_PROTOCOL_MISMATCH", "TRANSPORT_FAILURE", "OPERATION_TIMEOUT", "PROTOCOL_FRAME_TOO_LARGE", "RUNTIME_PATH_INVALID", "RUNTIME_PATH_COLLISION", "REDACTION_FAILURE", "INTERNAL_ERROR", "TURN_FAILED", "TURN_INTERRUPTED", "AUDIT_INTEGRITY_FAILURE"] },
    "string": { "type": "string" },
    "nullable_string": { "type": ["string", "null"] },
    "integer": { "type": "integer", "minimum": 0 },
    "uuid": { "type": "string", "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$" },
    "nullable_uuid": { "oneOf": [{ "$ref": "#/$defs/uuid" }, { "type": "null" }] },
    "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "path": { "oneOf": [{ "type": "string" }, { "type": "object", "additionalProperties": false, "required": ["$dolgorae_path_bytes"], "properties": { "$dolgorae_path_bytes": { "type": "string", "contentEncoding": "base64", "pattern": "^(?:[A-Za-z0-9+/]{4})*(?:[A-Za-z0-9+/]{2}==|[A-Za-z0-9+/]{3}=)?$" } } }] },
    "json_value": {},
    "identity": { "enum": ["Absent", "Mismatch", "Match", "Unverifiable"] },
    "lifecycle": { "enum": ["starting", "idle", "running", "waiting_approval", "paused", "closed", "start_failed", "outcome_unknown"] },
    "turn_status": { "enum": ["accepted", "running", "waiting_approval", "completed", "failed", "interrupted"] },
    "invalid_argument": { "$ref": "#/$defs/v_INVALID_ARGUMENT_false_argument_reason" },
    "workspace_not_initialized": { "$ref": "#/$defs/v_WORKSPACE_NOT_INITIALIZED_false_workspace_path" },
    "config_invalid": { "$ref": "#/$defs/v_CONFIG_INVALID_false_path_reason" },
    "profile_config_invalid": { "$ref": "#/$defs/v_PROFILE_CONFIG_INVALID_false_path_reason" },
    "profile_not_found": { "$ref": "#/$defs/v_PROFILE_NOT_FOUND_false_profile" },
    "run_not_found": { "$ref": "#/$defs/v_RUN_NOT_FOUND_false_run_id" },
    "thread_not_found": { "$ref": "#/$defs/v_THREAD_NOT_FOUND_false_run_id_thread_id" },
    "turn_not_found": { "$ref": "#/$defs/v_TURN_NOT_FOUND_false_run_id_turn_id" },
    "request_not_found": { "$ref": "#/$defs/v_REQUEST_NOT_FOUND_false_run_id_request_id" },
    "profile_already_exists": { "$ref": "#/$defs/v_PROFILE_ALREADY_EXISTS_false_profile" },
    "profile_server_busy": { "$ref": "#/$defs/v_PROFILE_SERVER_BUSY_true_profile_server_key_reason" },
    "workspace_initialization_conflict": { "$ref": "#/$defs/v_WORKSPACE_INITIALIZATION_CONFLICT_false_workspace_path_reason" },
    "run_state_conflict": { "$ref": "#/$defs/v_RUN_STATE_CONFLICT_false_run_id_state_operation" },
    "policy_rejected": { "$ref": "#/$defs/v_POLICY_REJECTED_false_policy_operation" },
    "run_busy": { "$ref": "#/$defs/v_RUN_BUSY_true_run_id_owner_kind" },
    "writer_busy": { "$ref": "#/$defs/v_WRITER_BUSY_true_workspace_id_holder_run_id_holder_state" },
    "idempotency_conflict": { "$ref": "#/$defs/v_IDEMPOTENCY_CONFLICT_false_run_id_recorded_input_digest_observed_input_digest" },
    "stale_request": { "$ref": "#/$defs/v_STALE_REQUEST_false_run_id_request_id_request_generation_current_generation" },
    "outcome_unknown": { "$ref": "#/$defs/v_OUTCOME_UNKNOWN_false_run_id_thread_id_turn_id" },
    "recovery_required": { "$ref": "#/$defs/v_RECOVERY_REQUIRED_false_run_id_generation_identity_verdict_reason" },
    "profile_mismatch": { "$ref": "#/$defs/v_PROFILE_MISMATCH_false_profile_field_expected_actual" },
    "compatibility_rejected": { "$ref": "#/$defs/v_COMPATIBILITY_REJECTED_false_profile_check_expected_actual" },
    "dolgorae_protocol_mismatch": { "$ref": "#/$defs/v_DOLGORAE_PROTOCOL_MISMATCH_false_expected_protocol_actual_protocol_control_v1_available" },
    "protocol_frame_too_large": { "$ref": "#/$defs/v_PROTOCOL_FRAME_TOO_LARGE_false_channel_observed_bytes_limit_bytes" },
    "runtime_path_invalid": { "$ref": "#/$defs/v_RUNTIME_PATH_INVALID_false_path_reason" },
    "runtime_path_collision": { "$ref": "#/$defs/v_RUNTIME_PATH_COLLISION_false_path_expected_identity_observed_identity" },
    "redaction_failure": { "$ref": "#/$defs/v_REDACTION_FAILURE_false_source_kind_json_pointer_reason" },
    "internal_error": { "$ref": "#/$defs/v_INTERNAL_ERROR_false_invariant" },
    "turn_failed": { "$ref": "#/$defs/v_TURN_FAILED_false_run_id_turn_id_status" },
    "turn_interrupted": { "$ref": "#/$defs/v_TURN_INTERRUPTED_false_run_id_turn_id_status" },
    "audit_integrity_failure": { "$ref": "#/$defs/v_AUDIT_INTEGRITY_FAILURE_false_run_id_sequence_reason" },
    "transport_retryable": { "properties": { "code": { "const": "TRANSPORT_FAILURE" }, "retryable": { "const": true }, "details": { "$ref": "#/$defs/d_transport_retryable" } } },
    "transport_not_retryable": { "properties": { "code": { "const": "TRANSPORT_FAILURE" }, "retryable": { "const": false }, "details": { "$ref": "#/$defs/d_transport_not_retryable" } } },
    "operation_timeout": { "properties": { "code": { "const": "OPERATION_TIMEOUT" }, "retryable": { "const": true }, "details": { "$ref": "#/$defs/d_operation_timeout" } } },
    "d_transport_retryable": { "type": "object", "additionalProperties": false, "required": ["stage", "acceptance", "request_id"], "properties": { "stage": { "enum": ["connect", "write", "read", "decode", "correlate", "shutdown"] }, "acceptance": { "enum": ["not_written", "not_accepted"] }, "request_id": { "$ref": "#/$defs/nullable_string" } } },
    "d_transport_not_retryable": { "type": "object", "additionalProperties": false, "required": ["stage", "acceptance", "request_id"], "properties": { "stage": { "enum": ["connect", "write", "read", "decode", "correlate", "shutdown"] }, "acceptance": { "enum": ["accepted", "uncertain"] }, "request_id": { "$ref": "#/$defs/nullable_string" } } },
    "v_INVALID_ARGUMENT_false_argument_reason": { "properties": { "code": { "const": "INVALID_ARGUMENT" }, "retryable": { "const": false }, "details": { "$ref": "#/$defs/d_argument_reason" } } },
    "v_WORKSPACE_NOT_INITIALIZED_false_workspace_path": { "properties": { "code": { "const": "WORKSPACE_NOT_INITIALIZED" }, "retryable": { "const": false }, "details": { "$ref": "#/$defs/d_workspace_path" } } },
    "v_CONFIG_INVALID_false_path_reason": { "properties": { "code": { "const": "CONFIG_INVALID" }, "retryable": { "const": false }, "details": { "$ref": "#/$defs/d_path_reason" } } },
    "v_PROFILE_CONFIG_INVALID_false_path_reason": { "properties": { "code": { "const": "PROFILE_CONFIG_INVALID" }, "retryable": { "const": false }, "details": { "$ref": "#/$defs/d_path_reason" } } },
    "v_PROFILE_NOT_FOUND_false_profile": { "properties": { "code": { "const": "PROFILE_NOT_FOUND" }, "retryable": { "const": false }, "details": { "$ref": "#/$defs/d_profile" } } },
    "v_RUN_NOT_FOUND_false_run_id": { "properties": { "code": { "const": "RUN_NOT_FOUND" }, "retryable": { "const": false }, "details": { "$ref": "#/$defs/d_run_id" } } },
    "v_THREAD_NOT_FOUND_false_run_id_thread_id": { "properties": { "code": { "const": "THREAD_NOT_FOUND" }, "retryable": { "const": false }, "details": { "$ref": "#/$defs/d_run_id_thread_id" } } },
    "v_TURN_NOT_FOUND_false_run_id_turn_id": { "properties": { "code": { "const": "TURN_NOT_FOUND" }, "retryable": { "const": false }, "details": { "$ref": "#/$defs/d_run_id_turn_id" } } },
    "v_REQUEST_NOT_FOUND_false_run_id_request_id": { "properties": { "code": { "const": "REQUEST_NOT_FOUND" }, "retryable": { "const": false }, "details": { "$ref": "#/$defs/d_run_id_request_id" } } },
    "v_PROFILE_ALREADY_EXISTS_false_profile": { "properties": { "code": { "const": "PROFILE_ALREADY_EXISTS" }, "retryable": { "const": false }, "details": { "$ref": "#/$defs/d_profile" } } },
    "v_PROFILE_SERVER_BUSY_true_profile_server_key_reason": { "properties": { "code": { "const": "PROFILE_SERVER_BUSY" }, "retryable": { "const": true }, "details": { "$ref": "#/$defs/d_profile_server" } } },
    "v_WORKSPACE_INITIALIZATION_CONFLICT_false_workspace_path_reason": { "properties": { "code": { "const": "WORKSPACE_INITIALIZATION_CONFLICT" }, "retryable": { "const": false }, "details": { "$ref": "#/$defs/d_workspace_path_reason" } } },
    "v_RUN_STATE_CONFLICT_false_run_id_state_operation": { "properties": { "code": { "const": "RUN_STATE_CONFLICT" }, "retryable": { "const": false }, "details": { "$ref": "#/$defs/d_run_state_operation" } } },
    "v_POLICY_REJECTED_false_policy_operation": { "properties": { "code": { "const": "POLICY_REJECTED" }, "retryable": { "const": false }, "details": { "$ref": "#/$defs/d_policy_operation" } } },
    "v_RUN_BUSY_true_run_id_owner_kind": { "properties": { "code": { "const": "RUN_BUSY" }, "retryable": { "const": true }, "details": { "$ref": "#/$defs/d_run_owner" } } },
    "v_WRITER_BUSY_true_workspace_id_holder_run_id_holder_state": { "properties": { "code": { "const": "WRITER_BUSY" }, "retryable": { "const": true }, "details": { "$ref": "#/$defs/d_writer" } } },
    "v_IDEMPOTENCY_CONFLICT_false_run_id_recorded_input_digest_observed_input_digest": { "properties": { "code": { "const": "IDEMPOTENCY_CONFLICT" }, "retryable": { "const": false }, "details": { "$ref": "#/$defs/d_idempotency" } } },
    "v_STALE_REQUEST_false_run_id_request_id_request_generation_current_generation": { "properties": { "code": { "const": "STALE_REQUEST" }, "retryable": { "const": false }, "details": { "$ref": "#/$defs/d_stale_request" } } },
    "v_OUTCOME_UNKNOWN_false_run_id_thread_id_turn_id": { "properties": { "code": { "const": "OUTCOME_UNKNOWN" }, "retryable": { "const": false }, "details": { "$ref": "#/$defs/d_outcome_unknown" } } },
    "v_RECOVERY_REQUIRED_false_run_id_generation_identity_verdict_reason": { "properties": { "code": { "const": "RECOVERY_REQUIRED" }, "retryable": { "const": false }, "details": { "$ref": "#/$defs/d_recovery" } } },
    "v_PROFILE_MISMATCH_false_profile_field_expected_actual": { "properties": { "code": { "const": "PROFILE_MISMATCH" }, "retryable": { "const": false }, "details": { "$ref": "#/$defs/d_profile_comparison" } } },
    "v_COMPATIBILITY_REJECTED_false_profile_check_expected_actual": { "properties": { "code": { "const": "COMPATIBILITY_REJECTED" }, "retryable": { "const": false }, "details": { "$ref": "#/$defs/d_compatibility" } } },
    "v_DOLGORAE_PROTOCOL_MISMATCH_false_expected_protocol_actual_protocol_control_v1_available": { "properties": { "code": { "const": "DOLGORAE_PROTOCOL_MISMATCH" }, "retryable": { "const": false }, "details": { "$ref": "#/$defs/d_protocol" } } },
    "v_PROTOCOL_FRAME_TOO_LARGE_false_channel_observed_bytes_limit_bytes": { "properties": { "code": { "const": "PROTOCOL_FRAME_TOO_LARGE" }, "retryable": { "const": false }, "details": { "$ref": "#/$defs/d_frame" } } },
    "v_RUNTIME_PATH_INVALID_false_path_reason": { "properties": { "code": { "const": "RUNTIME_PATH_INVALID" }, "retryable": { "const": false }, "details": { "$ref": "#/$defs/d_path_reason" } } },
    "v_RUNTIME_PATH_COLLISION_false_path_expected_identity_observed_identity": { "properties": { "code": { "const": "RUNTIME_PATH_COLLISION" }, "retryable": { "const": false }, "details": { "$ref": "#/$defs/d_path_collision" } } },
    "v_REDACTION_FAILURE_false_source_kind_json_pointer_reason": { "properties": { "code": { "const": "REDACTION_FAILURE" }, "retryable": { "const": false }, "details": { "$ref": "#/$defs/d_redaction" } } },
    "v_INTERNAL_ERROR_false_invariant": { "properties": { "code": { "const": "INTERNAL_ERROR" }, "retryable": { "const": false }, "details": { "$ref": "#/$defs/d_invariant" } } },
    "v_TURN_FAILED_false_run_id_turn_id_status": { "properties": { "code": { "const": "TURN_FAILED" }, "retryable": { "const": false }, "details": { "$ref": "#/$defs/d_turn_status" } } },
    "v_TURN_INTERRUPTED_false_run_id_turn_id_status": { "properties": { "code": { "const": "TURN_INTERRUPTED" }, "retryable": { "const": false }, "details": { "$ref": "#/$defs/d_turn_status" } } },
    "v_AUDIT_INTEGRITY_FAILURE_false_run_id_sequence_reason": { "properties": { "code": { "const": "AUDIT_INTEGRITY_FAILURE" }, "retryable": { "const": false }, "details": { "$ref": "#/$defs/d_audit" } } },
    "d_argument_reason": { "type": "object", "additionalProperties": false, "required": ["argument", "reason"], "properties": { "argument": { "$ref": "#/$defs/string" }, "reason": { "$ref": "#/$defs/string" } } },
    "d_workspace_path": { "type": "object", "additionalProperties": false, "required": ["workspace_path"], "properties": { "workspace_path": { "$ref": "#/$defs/path" } } },
    "d_path_reason": { "type": "object", "additionalProperties": false, "required": ["path", "reason"], "properties": { "path": { "$ref": "#/$defs/path" }, "reason": { "$ref": "#/$defs/string" } } },
    "d_profile": { "type": "object", "additionalProperties": false, "required": ["profile"], "properties": { "profile": { "$ref": "#/$defs/string" } } },
    "d_profile_server": { "type": "object", "additionalProperties": false, "required": ["profile", "server_key", "reason"], "properties": { "profile": { "$ref": "#/$defs/string" }, "server_key": { "$ref": "#/$defs/sha256" }, "reason": { "$ref": "#/$defs/string" } } },
    "d_run_id": { "type": "object", "additionalProperties": false, "required": ["run_id"], "properties": { "run_id": { "$ref": "#/$defs/uuid" } } },
    "d_run_id_thread_id": { "type": "object", "additionalProperties": false, "required": ["run_id", "thread_id"], "properties": { "run_id": { "$ref": "#/$defs/uuid" }, "thread_id": { "$ref": "#/$defs/string" } } },
    "d_run_id_turn_id": { "type": "object", "additionalProperties": false, "required": ["run_id", "turn_id"], "properties": { "run_id": { "$ref": "#/$defs/uuid" }, "turn_id": { "$ref": "#/$defs/string" } } },
    "d_run_id_request_id": { "type": "object", "additionalProperties": false, "required": ["run_id", "request_id"], "properties": { "run_id": { "$ref": "#/$defs/uuid" }, "request_id": { "$ref": "#/$defs/string" } } },
    "d_workspace_path_reason": { "type": "object", "additionalProperties": false, "required": ["workspace_path", "reason"], "properties": { "workspace_path": { "$ref": "#/$defs/path" }, "reason": { "$ref": "#/$defs/string" } } },
    "d_run_state_operation": { "type": "object", "additionalProperties": false, "required": ["run_id", "state", "operation"], "properties": { "run_id": { "$ref": "#/$defs/uuid" }, "state": { "$ref": "#/$defs/lifecycle" }, "operation": { "$ref": "#/$defs/string" } } },
    "d_policy_operation": { "type": "object", "additionalProperties": false, "required": ["policy", "operation"], "properties": { "policy": { "$ref": "#/$defs/string" }, "operation": { "$ref": "#/$defs/string" } } },
    "d_run_owner": { "type": "object", "additionalProperties": false, "required": ["run_id", "owner_kind"], "properties": { "run_id": { "$ref": "#/$defs/uuid" }, "owner_kind": { "enum": ["turn", "startup", "attachment"] } } },
    "d_writer": { "type": "object", "additionalProperties": false, "required": ["workspace_id", "holder_run_id", "holder_state"], "properties": { "workspace_id": { "$ref": "#/$defs/sha256" }, "holder_run_id": { "$ref": "#/$defs/nullable_uuid" }, "holder_state": { "oneOf": [{ "$ref": "#/$defs/lifecycle" }, { "type": "null" }] } } },
    "d_idempotency": { "type": "object", "additionalProperties": false, "required": ["run_id", "recorded_input_digest", "observed_input_digest"], "properties": { "run_id": { "$ref": "#/$defs/uuid" }, "recorded_input_digest": { "$ref": "#/$defs/sha256" }, "observed_input_digest": { "$ref": "#/$defs/sha256" } } },
    "d_outcome_unknown": { "type": "object", "additionalProperties": false, "required": ["run_id", "thread_id", "turn_id"], "properties": { "run_id": { "$ref": "#/$defs/uuid" }, "thread_id": { "$ref": "#/$defs/nullable_string" }, "turn_id": { "$ref": "#/$defs/nullable_string" } } },
    "d_operation_timeout": { "type": "object", "additionalProperties": false, "required": ["operation", "budget_ms"], "properties": { "operation": { "enum": ["replay", "schema_generation", "profile_doctor"] }, "budget_ms": { "$ref": "#/$defs/integer" } } },
    "d_stale_request": { "type": "object", "additionalProperties": false, "required": ["run_id", "request_id", "request_generation", "current_generation"], "properties": { "run_id": { "$ref": "#/$defs/uuid" }, "request_id": { "$ref": "#/$defs/string" }, "request_generation": { "$ref": "#/$defs/integer" }, "current_generation": { "$ref": "#/$defs/integer" } } },
    "d_recovery": { "type": "object", "additionalProperties": false, "required": ["run_id", "generation", "identity_verdict", "reason"], "properties": { "run_id": { "$ref": "#/$defs/uuid" }, "generation": { "$ref": "#/$defs/integer" }, "identity_verdict": { "$ref": "#/$defs/identity" }, "reason": { "$ref": "#/$defs/string" } } },
    "d_profile_comparison": { "type": "object", "additionalProperties": false, "required": ["profile", "field", "expected", "actual"], "properties": { "profile": { "$ref": "#/$defs/string" }, "field": { "$ref": "#/$defs/string" }, "expected": { "$ref": "#/$defs/json_value" }, "actual": { "$ref": "#/$defs/json_value" } } },
    "d_compatibility": { "type": "object", "additionalProperties": false, "required": ["profile", "check", "expected", "actual"], "properties": { "profile": { "$ref": "#/$defs/string" }, "check": { "$ref": "#/$defs/string" }, "expected": { "$ref": "#/$defs/json_value" }, "actual": { "$ref": "#/$defs/json_value" } } },
    "d_protocol": { "type": "object", "additionalProperties": false, "required": ["expected_protocol", "actual_protocol", "control_v1_available"], "properties": { "expected_protocol": { "$ref": "#/$defs/integer" }, "actual_protocol": { "$ref": "#/$defs/integer" }, "control_v1_available": { "type": "boolean" } } },
    "d_frame": { "type": "object", "additionalProperties": false, "required": ["channel", "observed_bytes", "limit_bytes"], "properties": { "channel": { "enum": ["cli_worker", "app_server_stdout", "app_server_stderr", "ledger"] }, "observed_bytes": { "$ref": "#/$defs/integer" }, "limit_bytes": { "$ref": "#/$defs/integer" } } },
