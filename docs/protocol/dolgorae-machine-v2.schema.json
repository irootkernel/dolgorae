{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dolgorae.local/schema/machine-output/v2",
  "title": "Dolgorae machine output v2",
  "oneOf": [
    {
      "$ref": "#/$defs/success"
    },
    {
      "$ref": "#/$defs/failure"
    }
  ],
  "$defs": {
    "base": {
      "type": "object",
      "required": [
        "schema_version",
        "ok",
        "command",
        "invocation_id"
      ],
      "properties": {
        "schema_version": {
          "const": 2
        },
        "ok": {
          "type": "boolean"
        },
        "command": {
          "$ref": "https://dolgorae.local/schema/machine-output/v1#/$defs/command"
        },
        "invocation_id": {
          "$ref": "https://dolgorae.local/schema/machine-output/v1#/$defs/uuid"
        }
      }
    },
    "success": {
      "allOf": [
        {
          "$ref": "#/$defs/base"
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "schema_version",
            "ok",
            "command",
            "invocation_id",
            "data"
          ],
          "properties": {
            "schema_version": {
              "const": 2
            },
            "ok": {
              "const": true
            },
            "command": {
              "$ref": "https://dolgorae.local/schema/machine-output/v1#/$defs/command"
            },
            "invocation_id": {
              "$ref": "https://dolgorae.local/schema/machine-output/v1#/$defs/uuid"
            },
            "data": {
              "oneOf": [
                { "$ref": "https://dolgorae.local/schema/machine-output/v1#/$defs/data" },
                { "$ref": "#/$defs/global_membership_verification" }
              ]
            }
          }
        }
      ]
    },
    "global_membership_verification": {
      "type": "object",
      "additionalProperties": false,
      "required": ["profile", "server_key", "complete", "revision", "records", "members"],
      "properties": {
        "profile": { "type": "string", "minLength": 1 },
        "server_key": { "$ref": "https://dolgorae.local/schema/profile-membership/v2#/$defs/sha256" },
        "complete": { "const": true },
        "revision": { "type": "integer", "minimum": 0 },
        "records": { "type": "integer", "minimum": 0 },
        "members": {
          "type": "array",
          "items": { "$ref": "https://dolgorae.local/schema/profile-membership/v2#/$defs/record" }
        }
      }
    },
    "failure": {
      "allOf": [
        {
          "$ref": "#/$defs/base"
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "schema_version",
            "ok",
            "command",
            "invocation_id",
            "error"
          ],
          "properties": {
            "schema_version": {
              "const": 2
            },
            "ok": {
              "const": false
            },
            "command": {
              "$ref": "https://dolgorae.local/schema/machine-output/v1#/$defs/command"
            },
            "invocation_id": {
              "$ref": "https://dolgorae.local/schema/machine-output/v1#/$defs/uuid"
            },
            "error": {
              "$ref": "https://dolgorae.local/schema/error-contract/v2"
            }
          }
        }
      ]
    }
  }
}
