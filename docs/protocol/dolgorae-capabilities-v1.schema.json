{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dolgorae.local/schema/capabilities/v1",
  "title": "Dolgorae runtime capabilities v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["dolgorae_version", "machine_protocol_version", "event_protocol_version", "supported_transports", "app_server_transport", "profile_launch_mode", "projection_profiles", "control_modes", "execution_lanes", "assurance", "lane_capabilities", "independent_run_concurrency", "features", "interactions", "access_policy_transition", "background_execution_control", "native_subagents", "native_subagents_policy", "profile"],
  "properties": {
    "dolgorae_version": { "type": "string", "minLength": 1 },
    "machine_protocol_version": { "const": 1 },
    "event_protocol_version": { "const": 1 },
    "supported_transports": { "type": "array", "const": ["machine_cli"] },
    "app_server_transport": { "const": "direct_websocket_unix" },
    "profile_launch_mode": { "const": "dolgorae_owned_direct_executable" },
    "projection_profiles": { "type": "array", "const": ["minimal", "operational"] },
    "control_modes": { "type": "array", "const": ["direct_interactive", "managed_agent"] },
    "execution_lanes": { "type": "array", "const": ["shared_readonly", "dedicated"] },
    "assurance": {
      "type": "object", "additionalProperties": false,
      "required": ["supported", "maximum_achievable", "selection_time"],
      "properties": {
        "supported": { "type": "array", "const": ["best_effort_personal_alpha"] },
        "maximum_achievable": { "const": "best_effort_personal_alpha" },
        "selection_time": { "const": "before_run_allocation" }
      }
    },
    "lane_capabilities": {
      "type": "object", "additionalProperties": false,
      "required": ["shared_readonly", "dedicated"],
      "properties": {
        "shared_readonly": {
          "type": "object", "additionalProperties": false,
          "required": ["command_execution", "background_control", "writer_support", "codex_mode"],
          "properties": {
            "command_execution": { "const": "plan_mode_readonly" },
            "background_control": { "const": "profile_aggregate_only" },
            "writer_support": { "const": false },
            "codex_mode": { "const": "plan" }
          }
        },
        "dedicated": {
          "type": "object", "additionalProperties": false,
          "required": ["command_execution", "background_control", "writer_support", "physical_start"],
          "properties": {
            "command_execution": { "const": "supported" },
            "background_control": { "const": "best_effort_personal_alpha" },
            "writer_support": { "const": true },
            "physical_start": { "const": "lazy_first_input" }
          }
        }
      }
    },
    "independent_run_concurrency": {
      "type": "object", "additionalProperties": false,
      "required": ["basic_same_home_coexistence", "storage_and_long_duration", "resource_warning_live_dedicated"],
      "properties": {
        "basic_same_home_coexistence": { "enum": ["supported", "unverified", "unsafe"] },
        "storage_and_long_duration": { "enum": ["supported", "unverified", "unsafe"] },
        "resource_warning_live_dedicated": { "const": 6 }
      }
    },
    "features": {
      "type": "object", "additionalProperties": false,
      "required": ["persistent_runs", "run_fork", "reader_writer_access", "threadless_acquire_write", "writer_handoff", "durable_writer_authority", "sticky_dedicated_lanes", "control_modes", "assurance_negotiation", "profile_server_migration", "profile_membership_repair", "event_replay", "artifact_retrieval", "profile_diagnostics", "controller_binding", "worker_controller_revalidation", "operator_capability", "operator_controller_reset", "safe_client_projection", "public_local_socket", "workspace_event_stream"],
      "properties": {
        "persistent_runs": { "const": true }, "run_fork": { "const": true },
        "reader_writer_access": { "const": true }, "threadless_acquire_write": { "const": false }, "writer_handoff": { "const": true },
        "durable_writer_authority": { "const": true },
        "sticky_dedicated_lanes": { "const": true }, "control_modes": { "const": true }, "assurance_negotiation": { "const": true },
        "profile_server_migration": { "const": true }, "profile_membership_repair": { "const": true },
        "event_replay": { "const": true }, "artifact_retrieval": { "const": true }, "profile_diagnostics": { "const": true }, "controller_binding": { "const": true },
        "worker_controller_revalidation": { "const": true }, "operator_capability": { "const": true },
        "operator_controller_reset": { "const": true }, "safe_client_projection": { "const": true },
        "public_local_socket": { "const": false }, "workspace_event_stream": { "const": false }
      }
    },
    "interactions": {
      "type": "object", "additionalProperties": false,
      "required": ["command_execution_approval", "file_change_approval", "permission_request", "user_input", "mcp_elicitation", "connector_approval"],
      "properties": {
        "command_execution_approval": { "$ref": "#/$defs/support" },
        "file_change_approval": { "$ref": "#/$defs/support" },
        "permission_request": { "$ref": "#/$defs/support" },
        "user_input": { "$ref": "#/$defs/support" },
        "mcp_elicitation": { "$ref": "#/$defs/support" },
        "connector_approval": { "$ref": "#/$defs/support" }
      }
    },
    "access_policy_transition": { "enum": ["supported", "unavailable", "unverified"] },
    "background_execution_control": {
      "type": "object", "additionalProperties": false,
      "required": ["support", "mechanism"],
      "properties": {
        "support": { "enum": ["supported", "unavailable", "unverified"] },
        "mechanism": { "enum": ["dedicated_lane_process_census", "hybrid", null] }
      },
      "allOf": [
        { "if": { "properties": { "support": { "const": "supported" } } }, "then": { "properties": { "mechanism": { "enum": ["dedicated_lane_process_census", "hybrid"] } } } },
        { "if": { "properties": { "support": { "const": "unavailable" } } }, "then": { "properties": { "mechanism": { "const": null } } } }
      ]
    },
    "native_subagents": { "enum": ["supported", "unavailable", "unverified"] },
    "native_subagents_policy": { "enum": ["enabled", "disabled"] },
    "profile": { "type": ["string", "null"] }
  },
  "allOf": [
    { "if": { "properties": { "access_policy_transition": { "const": "supported" } } }, "then": { "properties": { "profile": { "type": "string" } } } },
    { "if": { "properties": { "background_execution_control": { "properties": { "support": { "const": "supported" } } } } }, "then": { "properties": { "profile": { "type": "string" } } } },
    { "if": { "properties": { "native_subagents": { "const": "supported" } } }, "then": { "properties": { "profile": { "type": "string" } } } },
    { "if": { "properties": { "profile": { "type": "null" } } }, "then": { "properties": { "access_policy_transition": { "const": "unverified" }, "background_execution_control": { "properties": { "support": { "const": "unverified" }, "mechanism": { "const": "dedicated_lane_process_census" } } }, "native_subagents": { "const": "unverified" } } } }
  ],
  "$defs": { "support": { "enum": ["supported", "recognized_unsupported", "unavailable"] } }
}
