{
  "contract_id": "dolgorae.grpc-error-mapping/v1",
  "schema_version": 1,
  "error_detail_type": "dolgorae.public.v1.DolgoraeErrorDetail",
  "error_detail_version": 1,
  "required_action_type": "dolgorae.public.v1.RequiredClientAction",
  "default_status": "FAILED_PRECONDITION",
  "default_required_action": "REQUIRED_CLIENT_ACTION_ABORT",
  "default_retry_classification": "RETRY_CLASSIFICATION_FORBIDDEN",
  "default_recovery_classification": "RECOVERY_CLASSIFICATION_NONE",
  "retry_classification_overrides": {
    "RETRY_CLASSIFICATION_EXACT_IDEMPOTENCY_KEY": ["DEDICATED_SERVER_START_FAILED"],
    "RETRY_CLASSIFICATION_TOKENLESS_AFTER_SNAPSHOT": ["SLOW_CONSUMER", "SERVER_SHUTDOWN", "TRANSPORT_FAILURE"],
    "RETRY_CLASSIFICATION_AFTER_RECONCILE": ["BACKGROUND_EXECUTION_UNVERIFIED", "THREAD_RESIDENCY_CONFLICT", "DEDICATED_HISTORY_BARRIER_FAILED", "INTERACTION_OUTCOME_UNKNOWN", "OUTCOME_UNKNOWN", "RECOVERY_REQUIRED"]
  },
  "recovery_classification_overrides": {
    "RECOVERY_CLASSIFICATION_SNAPSHOT_REQUIRED": ["RUN_STATE_CONFLICT", "STALE_WRITER_GENERATION", "INTERACTION_NOT_FOUND", "INTERACTION_ALREADY_RESOLVED", "INTERACTION_STALE", "SLOW_CONSUMER", "SERVER_SHUTDOWN", "TRANSPORT_FAILURE"],
    "RECOVERY_CLASSIFICATION_RECONCILE_REQUIRED": ["BACKGROUND_EXECUTION_UNVERIFIED", "THREAD_RESIDENCY_CONFLICT", "DEDICATED_HISTORY_BARRIER_FAILED", "RECOVERY_REQUIRED"],
    "RECOVERY_CLASSIFICATION_OUTCOME_UNKNOWN": ["INTERACTION_OUTCOME_UNKNOWN", "OUTCOME_UNKNOWN"]
  },
  "method_overrides": {
    "ControllerService.VerifyController": {
      "CONTROLLER_MISMATCH": {
        "required_action": "REQUIRED_CLIENT_ACTION_ABORT",
        "retry_classification": "RETRY_CLASSIFICATION_FORBIDDEN",
        "recovery_classification": "RECOVERY_CLASSIFICATION_NONE"
      }
    },
    "RunService.ResumeRun": {
      "DEDICATED_SERVER_START_FAILED": {
        "required_action": "REQUIRED_CLIENT_ACTION_REFRESH_SNAPSHOT",
        "retry_classification": "RETRY_CLASSIFICATION_TOKENLESS_AFTER_SNAPSHOT",
        "recovery_classification": "RECOVERY_CLASSIFICATION_SNAPSHOT_REQUIRED"
      }
    },
    "RunService.SubmitTurn": {
      "DEDICATED_SERVER_START_FAILED": {
        "required_action": "REQUIRED_CLIENT_ACTION_RETRY_EXACT_IDEMPOTENCY_KEY",
        "retry_classification": "RETRY_CLASSIFICATION_EXACT_IDEMPOTENCY_KEY",
        "recovery_classification": "RECOVERY_CLASSIFICATION_NONE"
      },
      "SERVER_SHUTDOWN": {
        "required_action": "REQUIRED_CLIENT_ACTION_REFRESH_SNAPSHOT",
        "retry_classification": "RETRY_CLASSIFICATION_EXACT_IDEMPOTENCY_KEY",
        "recovery_classification": "RECOVERY_CLASSIFICATION_SNAPSHOT_REQUIRED"
      },
      "TRANSPORT_FAILURE": {
        "required_action": "REQUIRED_CLIENT_ACTION_REFRESH_SNAPSHOT",
        "retry_classification": "RETRY_CLASSIFICATION_EXACT_IDEMPOTENCY_KEY",
        "recovery_classification": "RECOVERY_CLASSIFICATION_SNAPSHOT_REQUIRED"
      }
    },
    "InteractionService.ResolveInteraction": {
      "SERVER_SHUTDOWN": {
        "required_action": "REQUIRED_CLIENT_ACTION_REFETCH_INTERACTION",
        "retry_classification": "RETRY_CLASSIFICATION_AFTER_RECONCILE",
        "recovery_classification": "RECOVERY_CLASSIFICATION_OUTCOME_UNKNOWN"
      },
      "TRANSPORT_FAILURE": {
        "required_action": "REQUIRED_CLIENT_ACTION_REFETCH_INTERACTION",
        "retry_classification": "RETRY_CLASSIFICATION_AFTER_RECONCILE",
        "recovery_classification": "RECOVERY_CLASSIFICATION_OUTCOME_UNKNOWN"
      }
    }
  },
  "method_class_overrides": {
    "server_stream": {
      "SERVER_SHUTDOWN": {
        "required_action": "REQUIRED_CLIENT_ACTION_RECONNECT_FROM_COMMITTED_CURSOR",
        "retry_classification": "RETRY_CLASSIFICATION_TOKENLESS_AFTER_SNAPSHOT",
        "recovery_classification": "RECOVERY_CLASSIFICATION_SNAPSHOT_REQUIRED"
      },
      "TRANSPORT_FAILURE": {
        "required_action": "REQUIRED_CLIENT_ACTION_RECONNECT_FROM_COMMITTED_CURSOR",
        "retry_classification": "RETRY_CLASSIFICATION_TOKENLESS_AFTER_SNAPSHOT",
        "recovery_classification": "RECOVERY_CLASSIFICATION_SNAPSHOT_REQUIRED"
      }
    },
    "idempotent_mutation": {
      "SERVER_SHUTDOWN": {
        "required_action": "REQUIRED_CLIENT_ACTION_RETRY_EXACT_IDEMPOTENCY_KEY",
        "retry_classification": "RETRY_CLASSIFICATION_EXACT_IDEMPOTENCY_KEY",
        "recovery_classification": "RECOVERY_CLASSIFICATION_NONE"
      },
      "TRANSPORT_FAILURE": {
        "required_action": "REQUIRED_CLIENT_ACTION_RETRY_EXACT_IDEMPOTENCY_KEY",
        "retry_classification": "RETRY_CLASSIFICATION_EXACT_IDEMPOTENCY_KEY",
        "recovery_classification": "RECOVERY_CLASSIFICATION_NONE"
      }
    },
    "tokenless_mutation": {
      "SERVER_SHUTDOWN": {
        "required_action": "REQUIRED_CLIENT_ACTION_REFRESH_SNAPSHOT",
        "retry_classification": "RETRY_CLASSIFICATION_TOKENLESS_AFTER_SNAPSHOT",
        "recovery_classification": "RECOVERY_CLASSIFICATION_SNAPSHOT_REQUIRED"
      },
      "TRANSPORT_FAILURE": {
        "required_action": "REQUIRED_CLIENT_ACTION_REFRESH_SNAPSHOT",
        "retry_classification": "RETRY_CLASSIFICATION_TOKENLESS_AFTER_SNAPSHOT",
        "recovery_classification": "RECOVERY_CLASSIFICATION_SNAPSHOT_REQUIRED"
      }
    },
    "unary_read": {
      "SERVER_SHUTDOWN": {
        "required_action": "REQUIRED_CLIENT_ACTION_REFRESH_SNAPSHOT",
        "retry_classification": "RETRY_CLASSIFICATION_TOKENLESS_AFTER_SNAPSHOT",
        "recovery_classification": "RECOVERY_CLASSIFICATION_SNAPSHOT_REQUIRED"
      },
      "TRANSPORT_FAILURE": {
        "required_action": "REQUIRED_CLIENT_ACTION_REFRESH_SNAPSHOT",
        "retry_classification": "RETRY_CLASSIFICATION_TOKENLESS_AFTER_SNAPSHOT",
        "recovery_classification": "RECOVERY_CLASSIFICATION_SNAPSHOT_REQUIRED"
      }
    }
  },
  "required_action_overrides": {
    "REQUIRED_CLIENT_ACTION_FIX_REQUEST": ["INVALID_ARGUMENT", "CONTROL_MODE_REQUIRED", "PURPOSE_REQUIRED", "EXECUTION_LANE_REQUIRED", "ARTIFACT_RANGE_INVALID", "EVENT_CURSOR_INVALID", "INTERACTION_RESPONSE_INVALID", "INTERACTION_RESPONSE_TOO_LARGE"],
    "REQUIRED_CLIENT_ACTION_REFRESH_CAPABILITIES": ["CAPABILITY_UNSUPPORTED", "EXECUTION_LANE_UNSUPPORTED", "ASSURANCE_LEVEL_UNAVAILABLE", "PROJECTION_PROFILE_UNSUPPORTED", "PROTOCOL_VERSION_UNSUPPORTED", "UNSUPPORTED_SCHEMA_VERSION", "COMPATIBILITY_REJECTED"],
    "REQUIRED_CLIENT_ACTION_REFRESH_SNAPSHOT": ["RUN_STATE_CONFLICT", "INTERACTION_ALREADY_RESOLVED", "INTERACTION_STALE", "STALE_WRITER_GENERATION"],
    "REQUIRED_CLIENT_ACTION_VERIFY_CONTROLLER": ["CONTROLLER_MISMATCH", "OBSERVER_MUTATION_FORBIDDEN", "INTERACTION_ARTIFACT_REQUIRES_CONTROLLER"],
    "REQUIRED_CLIENT_ACTION_USE_COMPATIBLE_CONTROLLER": ["CONTROL_MODE_CONTROLLER_MISMATCH", "CROSS_CONTROLLER_RELEASE_REQUIRED"],
    "REQUIRED_CLIENT_ACTION_USE_NEW_SAME_PRINCIPAL_CONTROLLER": ["WRITE_CONTINUATION_CONTROLLER_INVALID"],
    "REQUIRED_CLIENT_ACTION_USE_SUPPORTED_PROFILE": ["PROFILE_NOT_FOUND", "PROFILE_MISMATCH", "PROFILE_MIGRATION_REQUIRED", "PROFILE_LANE_MIGRATION_REQUIRED"],
    "REQUIRED_CLIENT_ACTION_USE_TERMINAL_SOURCE": ["WRITE_CONTINUATION_SOURCE_NOT_TERMINAL"],
    "REQUIRED_CLIENT_ACTION_SUBMIT_WRITE_TURN": ["THREADLESS_REQUIRES_WRITE_TURN"],
    "REQUIRED_CLIENT_ACTION_CREATE_WRITE_CONTINUATION": ["SHARED_RUN_WRITE_FORBIDDEN", "ACCESS_TRANSITION_UNSUPPORTED"],
    "REQUIRED_CLIENT_ACTION_WAIT": ["RUN_BUSY", "WRITER_BUSY", "PROFILE_SERVER_BUSY"],
    "REQUIRED_CLIENT_ACTION_RETRY_EXACT_IDEMPOTENCY_KEY": ["DEDICATED_SERVER_START_FAILED"],
    "REQUIRED_CLIENT_ACTION_REFETCH_INTERACTION": ["INTERACTION_NOT_FOUND", "INTERACTION_OUTCOME_UNKNOWN"],
    "REQUIRED_CLIENT_ACTION_RECONCILE_RUN": ["OUTCOME_UNKNOWN", "THREAD_RESIDENCY_CONFLICT", "BACKGROUND_EXECUTION_UNVERIFIED"],
    "REQUIRED_CLIENT_ACTION_RECOVER_RUN": ["RECOVERY_REQUIRED", "DEDICATED_HISTORY_BARRIER_FAILED"],
    "REQUIRED_CLIENT_ACTION_RECONNECT_FROM_COMMITTED_CURSOR": ["SLOW_CONSUMER", "SERVER_SHUTDOWN", "TRANSPORT_FAILURE"],
    "REQUIRED_CLIENT_ACTION_FIX_SOCKET_PATH": ["RPC_SOCKET_UNSAFE"],
    "REQUIRED_CLIENT_ACTION_OPERATOR_REPAIR": ["OPERATOR_MISMATCH", "CONTROLLER_RESET_NOT_ALLOWED", "AUDIT_INTEGRITY_FAILURE", "RUN_STATE_INVARIANT_VIOLATION"]
  },
  "status_overrides": {
    "INVALID_ARGUMENT": [
      "INVALID_ARGUMENT",
      "CONTROL_MODE_REQUIRED",
      "PURPOSE_REQUIRED",
      "EXECUTION_LANE_REQUIRED",
      "ARTIFACT_RANGE_INVALID",
      "EVENT_CURSOR_INVALID",
      "UNSUPPORTED_SCHEMA_VERSION"
    ],
    "NOT_FOUND": [
      "WORKSPACE_NOT_INITIALIZED",
      "PROFILE_NOT_FOUND",
      "RUN_NOT_FOUND",
      "THREAD_NOT_FOUND",
      "TURN_NOT_FOUND",
      "INTERACTION_NOT_FOUND",
      "ARTIFACT_NOT_FOUND"
    ],
    "PERMISSION_DENIED": [
      "INTERACTION_FULL_PAYLOAD_REQUIRES_CONTROLLER",
      "INTERACTION_ARTIFACT_REQUIRES_CONTROLLER",
      "OBSERVER_MUTATION_FORBIDDEN",
      "CONTROLLER_MISMATCH",
      "OPERATOR_MISMATCH",
      "CONTROL_MODE_CONTROLLER_MISMATCH"
    ],
    "ABORTED": [
      "WORKSPACE_INITIALIZATION_CONFLICT",
      "RUN_STATE_CONFLICT",
      "RUN_BUSY",
      "WRITER_BUSY",
      "WRITER_HANDOFF_NOT_ALLOWED",
      "CROSS_CONTROLLER_RELEASE_REQUIRED",
      "STALE_WRITER_GENERATION",
      "IDEMPOTENCY_CONFLICT",
      "INTERACTION_ALREADY_RESOLVED",
      "INTERACTION_STALE",
      "RPC_SERVER_ALREADY_RUNNING"
    ],
    "RESOURCE_EXHAUSTED": [
      "SLOW_CONSUMER",
      "PROTOCOL_FRAME_TOO_LARGE",
      "INTERACTION_RESPONSE_TOO_LARGE",
      "INTERACTION_PAYLOAD_TOO_LARGE"
    ],
    "UNAVAILABLE": [
      "DEDICATED_SERVER_START_FAILED",
      "TRANSPORT_FAILURE",
      "OPERATION_TIMEOUT",
      "RUNTIME_PATH_INVALID",
      "RUNTIME_PATH_COLLISION",
      "RPC_SOCKET_UNSAFE",
      "SERVER_SHUTDOWN"
    ],
    "DATA_LOSS": [
      "RUN_STATE_INVARIANT_VIOLATION",
      "ARTIFACT_INTEGRITY_FAILURE",
      "AUDIT_INTEGRITY_FAILURE"
    ],
    "INTERNAL": [
      "REDACTION_FAILURE",
      "INTERNAL_ERROR"
    ]
  },
  "client_rules": {
    "parse_status_text": false,
    "require_typed_detail_for_semantic_error": true,
    "grpc_ok_means_turn_completed": false,
    "transparent_mutation_retry": false,
    "unknown_detail_version": "treat_as_unsupported_schema_version"
  }
}
