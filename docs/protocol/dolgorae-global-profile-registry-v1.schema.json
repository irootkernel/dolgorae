{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dolgorae.local/schema/global-profile-registry/v1",
  "title": "Dolgorae global Codex Profile registry v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "profiles"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "profiles": {
      "type": "object",
      "propertyNames": {
        "type": "string",
        "minLength": 1
      },
      "additionalProperties": {
        "$ref": "https://dolgorae.local/schema/local-profile-registry/v1#/$defs/profile"
      }
    }
  }
}
