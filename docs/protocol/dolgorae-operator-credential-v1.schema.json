{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dolgorae.local/schema/operator-credential/v1",
  "title": "Dolgorae local operator credential v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "operator_id", "capability"],
  "properties": {
    "schema_version": { "const": 1 },
    "operator_id": { "$ref": "#/$defs/uuid7" },
    "capability": {
      "type": "string",
      "contentEncoding": "base64url",
      "pattern": "^[A-Za-z0-9_-]{43}$",
      "x-canonicalDecodedBytes": 32
    }
  },
  "$defs": {
    "uuid7": { "type": "string", "format": "uuid", "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$" }
  }
}
