{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dolgorae.local/schema/artifact/v1",
  "title": "Dolgorae bounded run artifact v1",
  "oneOf": [
    { "$ref": "#/$defs/metadata" },
    { "$ref": "#/$defs/read" },
    { "$ref": "#/$defs/export" },
    { "$ref": "#/$defs/final_response" }
  ],
  "$defs": {
    "uuid7": { "type": "string", "format": "uuid", "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$" },
    "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "metadata": {
      "type": "object", "additionalProperties": false,
      "required": ["schema_version", "artifact_id", "run_id", "kind", "media_type", "byte_length", "sha256", "created_at", "retention", "integrity"],
      "properties": {
        "schema_version": { "const": 1 },
        "artifact_id": { "$ref": "#/$defs/uuid7" },
        "run_id": { "$ref": "#/$defs/uuid7" },
        "kind": { "enum": ["file_change_diff", "final_response"] },
        "media_type": { "enum": ["text/x-diff", "text/markdown"] },
        "byte_length": { "type": "integer", "minimum": 0, "maximum": 33554432 },
        "sha256": { "$ref": "#/$defs/sha256" },
        "created_at": { "type": "string", "format": "date-time" },
        "retention": { "const": "run_lifetime" },
        "integrity": { "enum": ["verified", "unverified", "failed"] }
      },
      "allOf": [
        { "if": { "properties": { "kind": { "const": "file_change_diff" } } }, "then": { "properties": { "media_type": { "const": "text/x-diff" }, "byte_length": { "maximum": 8388608 } } } },
        { "if": { "properties": { "kind": { "const": "final_response" } } }, "then": { "properties": { "media_type": { "const": "text/markdown" } } } }
      ]
    },
    "read": {
      "type": "object", "additionalProperties": false,
      "required": ["metadata", "offset", "byte_length", "content_base64", "eof"],
      "properties": {
        "metadata": { "$ref": "#/$defs/metadata" },
        "offset": { "type": "integer", "minimum": 0 },
        "byte_length": { "type": "integer", "minimum": 0, "maximum": 1048576 },
        "content_base64": { "type": "string", "contentEncoding": "base64", "pattern": "^(?:[A-Za-z0-9+/]{4})*(?:[A-Za-z0-9+/]{2}==|[A-Za-z0-9+/]{3}=)?$" },
        "eof": { "type": "boolean" }
      }
    },
    "export": {
      "type": "object", "additionalProperties": false,
      "required": ["metadata", "output_path"],
      "properties": {
        "metadata": { "$ref": "#/$defs/metadata" },
        "output_path": {
          "oneOf": [
            { "type": "string", "x-maxUtf8Bytes": 4096 },
            { "type": "object", "additionalProperties": false, "required": ["$dolgorae_path_bytes"], "properties": { "$dolgorae_path_bytes": { "type": "string", "contentEncoding": "base64", "pattern": "^(?:[A-Za-z0-9+/]{4})*(?:[A-Za-z0-9+/]{2}==|[A-Za-z0-9+/]{3}=)?$" } } }
          ]
        }
      }
    },
    "inline_response": { "type": "object", "additionalProperties": false, "required": ["kind", "text"], "properties": { "kind": { "const": "inline" }, "text": { "type": "string", "x-maxUtf8Bytes": 1048576 } } },
    "artifact_response": { "type": "object", "additionalProperties": false, "required": ["kind", "artifact"], "properties": { "kind": { "const": "artifact" }, "artifact": { "allOf": [{ "$ref": "#/$defs/metadata" }, { "properties": { "kind": { "const": "final_response" } } }] } } },
    "unavailable_response": { "type": "object", "additionalProperties": false, "required": ["kind", "reason", "observed_byte_length", "sha256"], "properties": { "kind": { "const": "unavailable" }, "reason": { "enum": ["too_large", "quota_exceeded", "write_failed"] }, "observed_byte_length": { "type": "integer", "minimum": 0 }, "sha256": { "$ref": "#/$defs/sha256" } } },
    "final_response": {
      "oneOf": [
        { "$ref": "#/$defs/inline_response" },
        { "$ref": "#/$defs/artifact_response" },
        { "$ref": "#/$defs/unavailable_response" },
        { "type": "null" }
      ]
    }
  }
}
