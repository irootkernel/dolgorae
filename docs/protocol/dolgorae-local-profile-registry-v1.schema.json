{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dolgorae.local/schema/local-profile-registry/v1",
  "title": "Dolgorae machine-local Runtime Profile registry v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "profiles"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "profiles": {
      "type": "object",
      "propertyNames": {
        "type": "string",
        "minLength": 1
      },
      "additionalProperties": {
        "$ref": "#/$defs/profile"
      }
    }
  },
  "$defs": {
    "profile": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "argv",
        "codex_home",
        "environment",
        "native_subagents"
      ],
      "properties": {
        "argv": {
          "type": "array",
          "minItems": 1,
          "prefixItems": [
            {
              "type": "string",
              "pattern": "^/"
            }
          ],
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "codex_home": {
          "type": "string",
          "pattern": "^/"
        },
        "environment": {
          "type": "object",
          "required": [
            "PATH",
            "LANG",
            "LC_ALL"
          ],
          "propertyNames": {
            "allOf": [
              {
                "minLength": 1
              },
              {
                "not": {
                  "pattern": "^(?:CODEX_HOME|HOME|USER|LOGNAME|SHELL|TMPDIR|DOLGORAE_.*)$"
                }
              }
            ]
          },
          "additionalProperties": {
            "type": "string",
            "minLength": 1
          }
        },
        "native_subagents": {
          "const": "enabled"
        }
      }
    }
  }
}
