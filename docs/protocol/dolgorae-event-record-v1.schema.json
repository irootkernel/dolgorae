{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dolgorae.local/schema/client-event-record/v1",
  "title": "Dolgorae client-safe durable event record v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "event_schema_version", "cursor", "event_id", "timestamp", "workspace_id", "run_id", "thread_id", "turn_id", "server_key", "server_epoch", "type", "payload"],
  "properties": {
    "schema_version": { "const": 1 },
    "event_schema_version": { "const": 1 },
    "cursor": { "$ref": "#/$defs/cursor" },
    "event_id": { "$ref": "#/$defs/uuid7" },
    "timestamp": { "type": "string", "format": "date-time" },
    "workspace_id": { "$ref": "#/$defs/sha256" },
    "run_id": { "$ref": "#/$defs/uuid7" },
    "thread_id": { "type": ["string", "null"], "x-maxUtf8Bytes": 256 },
    "turn_id": { "type": ["string", "null"], "x-maxUtf8Bytes": 256 },
    "server_key": { "$ref": "#/$defs/sha256" },
    "server_epoch": { "type": "integer", "minimum": 1 },
    "type": {
      "enum": ["run.state_changed", "turn.state_changed", "response.final", "interaction.opened", "interaction.resolved", "runtime.error", "usage.reported", "workspace.changes", "writer.state_changed", "recovery.required", "command.started", "command.completed", "diagnostic.reported", "generation.changed", "reasoning.suppressed"]
    },
    "payload": { "type": "object" }
  },
  "oneOf": [
    { "$ref": "#/$defs/v_run_state" }, { "$ref": "#/$defs/v_turn_state" },
    { "$ref": "#/$defs/v_response" }, { "$ref": "#/$defs/v_interaction_opened" },
    { "$ref": "#/$defs/v_interaction_resolved" }, { "$ref": "#/$defs/v_error" },
    { "$ref": "#/$defs/v_usage" }, { "$ref": "#/$defs/v_workspace_changes" },
    { "$ref": "#/$defs/v_writer" }, { "$ref": "#/$defs/v_recovery" },
    { "$ref": "#/$defs/v_command_started" }, { "$ref": "#/$defs/v_command" }, { "$ref": "#/$defs/v_diagnostic" },
    { "$ref": "#/$defs/v_generation" }, { "$ref": "#/$defs/v_reasoning" }
  ],
  "allOf": [
    {
      "if": { "properties": { "type": { "enum": ["turn.state_changed", "response.final", "interaction.opened", "interaction.resolved", "usage.reported", "workspace.changes", "command.started", "command.completed", "reasoning.suppressed"] } }, "required": ["type"] },
      "then": { "properties": { "thread_id": { "type": "string", "minLength": 1 }, "turn_id": { "type": "string", "minLength": 1 } } }
    }
  ],
  "$defs": {
    "uuid7": { "type": "string", "format": "uuid", "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$" },
    "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "cursor": { "type": "string", "pattern": "^[1-9][0-9]{0,19}$" },
    "path": { "oneOf": [{ "type": "string", "x-maxUtf8Bytes": 4096 }, { "type": "object", "additionalProperties": false, "required": ["$dolgorae_path_bytes"], "properties": { "$dolgorae_path_bytes": { "type": "string", "contentEncoding": "base64", "pattern": "^(?:[A-Za-z0-9+/]{4})*(?:[A-Za-z0-9+/]{2}==|[A-Za-z0-9+/]{3}=)?$" } } }] },
    "run_state_payload": { "type": "object", "additionalProperties": false, "required": ["previous", "current"], "properties": { "previous": { "type": ["string", "null"] }, "current": { "enum": ["starting", "idle", "running", "waiting_interaction", "reconciliation_required", "paused", "closed", "start_failed", "outcome_unknown"] } } },
    "turn_state_payload": { "type": "object", "additionalProperties": false, "required": ["previous", "current"], "properties": { "previous": { "type": ["string", "null"] }, "current": { "enum": ["reserved", "accepted", "running", "waiting_interaction", "interrupting", "completed", "failed", "interrupted", "outcome_unknown"] } } },
    "response_payload": { "type": "object", "additionalProperties": false, "required": ["response"], "properties": { "response": { "oneOf": [{ "$ref": "https://dolgorae.local/schema/artifact/v1#/$defs/inline_response" }, { "$ref": "https://dolgorae.local/schema/artifact/v1#/$defs/artifact_response" }] } } },
    "interaction_opened_payload": { "type": "object", "additionalProperties": false, "required": ["request_id", "interaction_kind"], "properties": { "request_id": { "type": "string", "x-maxUtf8Bytes": 256 }, "interaction_kind": { "enum": ["command_execution_approval", "file_change_approval", "user_input", "unsupported_request"] } } },
    "interaction_resolved_payload": { "type": "object", "additionalProperties": false, "required": ["request_id", "outcome"], "properties": { "request_id": { "type": "string", "x-maxUtf8Bytes": 256 }, "outcome": { "enum": ["accepted", "declined", "cancelled", "answered", "stale", "method_not_found"] } } },
    "error_payload": { "type": "object", "additionalProperties": false, "required": ["error_code", "message"], "properties": { "error_code": { "type": "string", "pattern": "^[A-Z][A-Z0-9_]*$" }, "message": { "type": "string", "x-maxUtf8Bytes": 4096 } } },
    "usage_payload": { "type": "object", "additionalProperties": false, "required": ["input_tokens", "output_tokens"], "properties": { "input_tokens": { "type": "integer", "minimum": 0 }, "output_tokens": { "type": "integer", "minimum": 0 } } },
    "workspace_changes_payload": { "type": "object", "additionalProperties": false, "required": ["paths", "truncated"], "properties": { "paths": { "type": "array", "maxItems": 4096, "items": { "$ref": "#/$defs/path" } }, "truncated": { "type": "boolean" } } },
    "writer_payload": { "type": "object", "additionalProperties": false, "required": ["previous", "current", "writer_run_id", "writer_generation"], "properties": { "previous": { "enum": ["none", "reserved", "active", "handoff_prepared", "releasing", "blocked_unknown"] }, "current": { "enum": ["none", "reserved", "active", "handoff_prepared", "releasing", "blocked_unknown"] }, "writer_run_id": { "oneOf": [{ "$ref": "#/$defs/uuid7" }, { "type": "null" }] }, "writer_generation": { "type": "integer", "minimum": 0 } } },
    "recovery_payload": { "type": "object", "additionalProperties": false, "required": ["reason"], "properties": { "reason": { "type": "string", "x-maxUtf8Bytes": 4096 } } },
    "command_started_payload": { "type": "object", "additionalProperties": false, "required": ["command"], "properties": { "command": { "type": "array", "maxItems": 256, "items": { "type": "string", "x-maxUtf8Bytes": 4096 } } } },
    "command_payload": { "type": "object", "additionalProperties": false, "required": ["command", "exit_status"], "properties": { "command": { "type": "array", "maxItems": 256, "items": { "type": "string", "x-maxUtf8Bytes": 4096 } }, "exit_status": { "type": ["integer", "null"] } } },
    "diagnostic_payload": { "type": "object", "additionalProperties": false, "required": ["message"], "properties": { "message": { "type": "string", "x-maxUtf8Bytes": 4096 } } },
    "generation_payload": { "type": "object", "additionalProperties": false, "required": ["run_generation", "server_epoch"], "properties": { "run_generation": { "type": "integer", "minimum": 0 }, "server_epoch": { "type": "integer", "minimum": 1 } } },
    "reasoning_payload": { "type": "object", "additionalProperties": false, "required": ["method", "byte_length", "sha256", "reason"], "properties": { "method": { "type": "string", "x-maxUtf8Bytes": 256 }, "byte_length": { "type": "integer", "minimum": 0 }, "sha256": { "$ref": "#/$defs/sha256" }, "reason": { "type": "string", "x-maxUtf8Bytes": 4096 } } },
    "v_run_state": { "properties": { "type": { "const": "run.state_changed" }, "payload": { "$ref": "#/$defs/run_state_payload" } }, "required": ["type", "payload"] },
    "v_turn_state": { "properties": { "type": { "const": "turn.state_changed" }, "payload": { "$ref": "#/$defs/turn_state_payload" } }, "required": ["type", "payload"] },
    "v_response": { "properties": { "type": { "const": "response.final" }, "payload": { "$ref": "#/$defs/response_payload" } }, "required": ["type", "payload"] },
    "v_interaction_opened": { "properties": { "type": { "const": "interaction.opened" }, "payload": { "$ref": "#/$defs/interaction_opened_payload" } }, "required": ["type", "payload"] },
    "v_interaction_resolved": { "properties": { "type": { "const": "interaction.resolved" }, "payload": { "$ref": "#/$defs/interaction_resolved_payload" } }, "required": ["type", "payload"] },
    "v_error": { "properties": { "type": { "const": "runtime.error" }, "payload": { "$ref": "#/$defs/error_payload" } }, "required": ["type", "payload"] },
    "v_usage": { "properties": { "type": { "const": "usage.reported" }, "payload": { "$ref": "#/$defs/usage_payload" } }, "required": ["type", "payload"] },
    "v_workspace_changes": { "properties": { "type": { "const": "workspace.changes" }, "payload": { "$ref": "#/$defs/workspace_changes_payload" } }, "required": ["type", "payload"] },
    "v_writer": { "properties": { "type": { "const": "writer.state_changed" }, "payload": { "$ref": "#/$defs/writer_payload" } }, "required": ["type", "payload"] },
    "v_recovery": { "properties": { "type": { "const": "recovery.required" }, "payload": { "$ref": "#/$defs/recovery_payload" } }, "required": ["type", "payload"] },
    "v_command_started": { "properties": { "type": { "const": "command.started" }, "payload": { "$ref": "#/$defs/command_started_payload" } }, "required": ["type", "payload"] },
    "v_command": { "properties": { "type": { "const": "command.completed" }, "payload": { "$ref": "#/$defs/command_payload" } }, "required": ["type", "payload"] },
    "v_diagnostic": { "properties": { "type": { "const": "diagnostic.reported" }, "payload": { "$ref": "#/$defs/diagnostic_payload" } }, "required": ["type", "payload"] },
    "v_generation": { "properties": { "type": { "const": "generation.changed" }, "payload": { "$ref": "#/$defs/generation_payload" } }, "required": ["type", "payload"] },
    "v_reasoning": { "properties": { "type": { "const": "reasoning.suppressed" }, "payload": { "$ref": "#/$defs/reasoning_payload" } }, "required": ["type", "payload"] }
  }
}
