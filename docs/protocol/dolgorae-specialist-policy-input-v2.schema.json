{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dolgorae.local/schema/specialist-policy-input/v2",
  "title": "Dolgorae Specialist Policy authoring input v2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "policy_name",
    "revision",
    "approval_policy",
    "max_active_specialists",
    "roles"
  ],
  "properties": {
    "schema_version": {
      "const": 2
    },
    "policy_name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "pattern": "^[a-z0-9][a-z0-9._-]{0,63}$"
    },
    "revision": {
      "type": "integer",
      "minimum": 1
    },
    "approval_policy": {
      "enum": [
        "user_approval_required",
        "fully_delegated"
      ]
    },
    "max_active_specialists": {
      "type": "integer",
      "minimum": 1,
      "maximum": 64
    },
    "roles": {
      "type": "array",
      "minItems": 1,
      "maxItems": 64,
      "items": {
        "$ref": "#/$defs/role_policy"
      }
    }
  },
  "$defs": {
    "role_source_reference": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "scope",
        "name"
      ],
      "properties": {
        "scope": {
          "enum": [
            "common",
            "project"
          ]
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64,
          "pattern": "^[a-z0-9][a-z0-9._-]{0,63}$"
        }
      }
    },
    "agent_configuration_input": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "selected_profile",
        "model",
        "default_effort",
        "purpose",
        "purpose_label",
        "required_capabilities",
        "execution_lane",
        "required_assurance",
        "native_subagent_policy"
      ],
      "properties": {
        "schema_version": {
          "const": 2
        },
        "selected_profile": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "global_profile_binding_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "model": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1,
          "x-maxUtf8Bytes": 128
        },
        "default_effort": {
          "type": "string",
          "minLength": 1,
          "x-maxUtf8Bytes": 64
        },
        "purpose": {
          "enum": [
            "planning",
            "implementation",
            "review",
            "research",
            "discussion",
            "workflow_stage",
            "other"
          ]
        },
        "purpose_label": {
          "type": [
            "string",
            "null"
          ],
          "x-maxUtf8Bytes": 256
        },
        "required_capabilities": {
          "type": "array",
          "maxItems": 64,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1,
            "x-maxUtf8Bytes": 128
          }
        },
        "execution_lane": {
          "enum": [
            "shared_readonly",
            "dedicated"
          ]
        },
        "required_assurance": {
          "const": "best_effort_personal_alpha"
        },
        "native_subagent_policy": {
          "const": "enabled"
        }
      }
    },
    "role_policy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "role_ref",
        "role_source",
        "agent_configuration",
        "max_active_instances",
        "reuse_policy",
        "allowed_access",
        "activation_policy",
        "primary_may_request",
        "collaboration_source",
        "collaboration_target",
        "auto_approve_when_fully_delegated"
      ],
      "properties": {
        "role_ref": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64,
          "pattern": "^[a-z0-9][a-z0-9._-]{0,63}$"
        },
        "role_source": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "scope",
            "name"
          ],
          "properties": {
            "scope": {
              "enum": [
                "common",
                "project"
              ]
            },
            "name": {
              "type": "string",
              "minLength": 1,
              "maxLength": 64,
              "pattern": "^[a-z0-9][a-z0-9._-]{0,63}$"
            }
          }
        },
        "agent_configuration": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "schema_version",
            "selected_profile",
            "model",
            "default_effort",
            "purpose",
            "purpose_label",
            "required_capabilities",
            "execution_lane",
            "required_assurance",
            "native_subagent_policy"
          ],
          "properties": {
            "schema_version": {
              "const": 2
            },
            "selected_profile": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128
            },
            "global_profile_binding_sha256": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            },
            "model": {
              "type": [
                "string",
                "null"
              ],
              "minLength": 1,
              "x-maxUtf8Bytes": 128
            },
            "default_effort": {
              "type": "string",
              "minLength": 1,
              "x-maxUtf8Bytes": 64
            },
            "purpose": {
              "enum": [
                "planning",
                "implementation",
                "review",
                "research",
                "discussion",
                "workflow_stage",
                "other"
              ]
            },
            "purpose_label": {
              "type": [
                "string",
                "null"
              ],
              "x-maxUtf8Bytes": 256
            },
            "required_capabilities": {
              "type": "array",
              "maxItems": 64,
              "uniqueItems": true,
              "items": {
                "type": "string",
                "minLength": 1,
                "x-maxUtf8Bytes": 128
              }
            },
            "execution_lane": {
              "enum": [
                "shared_readonly",
                "dedicated"
              ]
            },
            "required_assurance": {
              "const": "best_effort_personal_alpha"
            },
            "native_subagent_policy": {
              "const": "enabled"
            }
          }
        },
        "max_active_instances": {
          "type": "integer",
          "minimum": 1,
          "maximum": 16
        },
        "reuse_policy": {
          "enum": [
            "never",
            "reuse_idle_compatible",
            "reuse_any_compatible"
          ]
        },
        "allowed_access": {
          "type": "array",
          "minItems": 1,
          "maxItems": 3,
          "uniqueItems": true,
          "items": {
            "enum": [
              "read_only",
              "isolated_write",
              "canonical_workspace_write"
            ]
          }
        },
        "activation_policy": {
          "enum": [
            "on_mail",
            "manual",
            "keep_resident",
            "never"
          ]
        },
        "primary_may_request": {
          "type": "boolean"
        },
        "collaboration_source": {
          "type": "boolean"
        },
        "collaboration_target": {
          "type": "boolean"
        },
        "auto_approve_when_fully_delegated": {
          "type": "boolean"
        }
      }
    }
  },
  "x-invariants": [
    "role_ref values are unique",
    "one explicit scope and name selects every Role source",
    "write-capable roles require a dedicated execution lane",
    "collaboration-capable roles use on_mail or keep_resident activation",
    "fully delegated hiring is limited to roles whose auto-approval bit is true"
  ]
}
