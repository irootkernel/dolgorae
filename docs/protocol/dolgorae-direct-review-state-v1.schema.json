{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dolgorae.local/schema/direct-review-state/v1",
  "title": "Dolgorae protected direct-review control state v1",
  "description": "Internal persisted control state and bounded native-history final responses. These records do not advertise runtime support or grant Controller authority; they do not materialize candidate source files.",
  "oneOf": [
    {
      "$ref": "#/$defs/reader_binding"
    },
    {
      "$ref": "#/$defs/run_binding"
    },
    {
      "$ref": "#/$defs/issued_read"
    },
    {
      "$ref": "#/$defs/violation"
    },
    {
      "$ref": "#/$defs/history_check"
    },
    {
      "$ref": "#/$defs/history_response"
    }
  ],
  "$defs": {
    "uuid7": {
      "$ref": "https://dolgorae.local/schema/review-target/v1#/$defs/uuid7"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "native_id": {
      "type": "string",
      "minLength": 1,
      "x-maxUtf8Bytes": 128
    },
    "reader_binding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema",
        "review_id",
        "run_id",
        "workspace",
        "workspace_mode",
        "target"
      ],
      "properties": {
        "schema": {
          "const": "dolgorae-direct-reader-binding/v1"
        },
        "review_id": {
          "$ref": "#/$defs/uuid7"
        },
        "run_id": {
          "$ref": "#/$defs/uuid7"
        },
        "workspace": {
          "$ref": "https://dolgorae.local/schema/workspace-record/v1#/$defs/path"
        },
        "workspace_mode": {
          "enum": [
            "git",
            "non_git"
          ]
        },
        "target": {
          "$ref": "https://dolgorae.local/schema/review-target/v2#/$defs/target"
        }
      },
      "x-invariants": [
        "canonical workspace byte identity and accepted mode match the original Run",
        "target_sha256 verifies canonical target metadata; no candidate source bytes are stored",
        "binding remains immutable through restart and original-Reviewer recovery"
      ]
    },
    "run_binding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema",
        "review_id",
        "run_id"
      ],
      "properties": {
        "schema": {
          "const": "dolgorae-direct-review-run/v1"
        },
        "review_id": {
          "$ref": "#/$defs/uuid7"
        },
        "run_id": {
          "$ref": "#/$defs/uuid7"
        }
      },
      "x-invariants": [
        "the original Run maps to exactly one immutable reader binding"
      ]
    },
    "issued_read": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "thread_id",
        "turn_id",
        "call_id",
        "request_sha256",
        "receipt"
      ],
      "properties": {
        "thread_id": {
          "$ref": "#/$defs/native_id"
        },
        "turn_id": {
          "$ref": "#/$defs/native_id"
        },
        "call_id": {
          "$ref": "#/$defs/native_id"
        },
        "request_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "receipt": {
          "oneOf": [
            {
              "$ref": "https://dolgorae.local/schema/review-target/v2#/$defs/read_receipt"
            },
            {
              "$ref": "#/$defs/metadata_receipt"
            }
          ]
        }
      },
      "x-invariants": [
        "native identities come from the authenticated host frame, never model-supplied request fields",
        "receipt is durably published before candidate bytes are returned",
        "the same Thread/Turn/call reuses the original receipt only for identical admitted input",
        "issued reads contain no candidate bytes; missing replay receipts never cause issuance"
      ]
    },
    "violation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema",
        "review_id",
        "run_id"
      ],
      "properties": {
        "schema": {
          "const": "dolgorae-direct-review-violation/v1"
        },
        "review_id": {
          "$ref": "#/$defs/uuid7"
        },
        "run_id": {
          "$ref": "#/$defs/uuid7"
        }
      },
      "x-invariants": [
        "a provenance violation remains effective across restart and successful history recovery"
      ]
    },
    "history_check": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema",
        "review_id",
        "thread_id",
        "turn_id"
      ],
      "properties": {
        "schema": {
          "const": "dolgorae-direct-review-history/v1"
        },
        "review_id": {
          "$ref": "#/$defs/uuid7"
        },
        "thread_id": {
          "$ref": "#/$defs/native_id"
        },
        "turn_id": {
          "$ref": "#/$defs/native_id"
        }
      },
      "x-invariants": [
        "history intent is published before the native terminal journal record",
        "completion matches the original intent and follows correlated history inspection",
        "any intent without matching completion prevents verdict acceptance across restart"
      ]
    },
    "history_response": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema",
        "review_id",
        "thread_id",
        "turn_id",
        "final_response"
      ],
      "properties": {
        "schema": {
          "const": "dolgorae-direct-review-history-response/v1"
        },
        "review_id": {
          "$ref": "#/$defs/uuid7"
        },
        "thread_id": {
          "$ref": "#/$defs/native_id"
        },
        "turn_id": {
          "$ref": "#/$defs/native_id"
        },
        "final_response": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "$ref": "https://dolgorae.local/schema/artifact/v1#/$defs/inline_response"
            },
            {
              "$ref": "#/$defs/stored_response"
            },
            {
              "$ref": "#/$defs/unavailable_response"
            }
          ]
        }
      },
      "x-invariants": [
        "response is extracted from the original correlated native Turn history and persisted before inspection completion",
        "notification output cannot replace this authoritative response",
        "recovery requires identical response bytes and original identities"
      ]
    },
    "metadata_receipt": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema",
        "receipt_id",
        "review_id",
        "target_sha256",
        "side",
        "path",
        "sha256",
        "byte_offset",
        "byte_length"
      ],
      "properties": {
        "schema": {
          "const": "dolgorae-target-metadata-read-receipt/v1"
        },
        "receipt_id": {
          "$ref": "https://dolgorae.local/schema/review-target/v1#/$defs/uuid7"
        },
        "review_id": {
          "$ref": "https://dolgorae.local/schema/review-target/v1#/$defs/uuid7"
        },
        "target_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "side": {
          "const": "metadata"
        },
        "path": {
          "const": "target.json"
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "byte_offset": {
          "type": "integer",
          "minimum": 0
        },
        "byte_length": {
          "type": "integer",
          "minimum": 0,
          "maximum": 8388608
        }
      },
      "x-invariants": [
        "receipt is issued by the trusted target reader and stored durably; model-supplied identities are not receipts",
        "content digest binds admitted file side or a deterministic diff of its admitted sides; returned range must fit that content",
        "candidate line evidence must resolve inside bytes returned under the matching file-side receipt; diff receipts support transition evidence with null line locations"
      ]
    },
    "stored_response": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "artifact_id",
        "byte_length",
        "sha256",
        "created_at"
      ],
      "properties": {
        "kind": {
          "const": "artifact"
        },
        "artifact_id": {
          "$ref": "#/$defs/uuid7"
        },
        "byte_length": {
          "type": "integer",
          "minimum": 0
        },
        "sha256": {
          "$ref": "#/$defs/sha256"
        },
        "created_at": {
          "type": "string",
          "format": "date-time"
        }
      }
    },
    "unavailable_response": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "byte_length",
        "sha256",
        "reason"
      ],
      "properties": {
        "kind": {
          "const": "unavailable"
        },
        "byte_length": {
          "type": "integer",
          "minimum": 0
        },
        "sha256": {
          "$ref": "#/$defs/sha256"
        },
        "reason": {
          "enum": [
            "too_large",
            "quota_exceeded",
            "write_failed"
          ]
        }
      }
    }
  }
}
