{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dolgorae.local/schema/controller-credential/v1",
  "title": "Dolgorae controller credential v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "controller_id",
    "kind",
    "instance_id",
    "subject_id",
    "capability"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "controller_id": {
      "$ref": "#/$defs/uuid7"
    },
    "kind": {
      "enum": [
        "human_cli",
        "interactive_client",
        "workflow_orchestrator",
        "automation",
        "other"
      ]
    },
    "instance_id": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[^\\u0000-\\u001f\\u007f]+$",
      "x-maxUtf8Bytes": 128
    },
    "subject_id": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^[^\\u0000-\\u001f\\u007f]+$",
      "x-maxUtf8Bytes": 256
    },
    "capability": {
      "type": "string",
      "contentEncoding": "base64url",
      "pattern": "^[A-Za-z0-9_-]{43}$",
      "x-canonicalDecodedBytes": 32
    },
    "orchestration_launch": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "use_case",
        "specialist_policy_name"
      ],
      "properties": {
        "use_case": {
          "const": "dolgorae_orchestrated_session"
        },
        "specialist_policy_name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-z0-9][a-z0-9._-]{0,127}$"
        }
      }
    }
  },
  "$defs": {
    "uuid7": {
      "type": "string",
      "format": "uuid",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    }
  },
  "x-invariants": [
    "orchestration_launch is consumed only when creating a direct-interactive root Run",
    "managed-agent and child Run credentials must not contain orchestration_launch",
    "the referenced policy is loaded from the target workspace registry and snapshotted before Run allocation"
  ],
  "allOf": [
    {
      "if": {
        "required": [
          "orchestration_launch"
        ]
      },
      "then": {
        "properties": {
          "kind": {
            "enum": [
              "human_cli",
              "interactive_client"
            ]
          }
        }
      }
    }
  ],
  "x-semanticValidator": "protocol/validators/validate_controller_credential_v1.py"
}
