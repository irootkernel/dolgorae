{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dolgorae.local/schema/controller-credential/v1",
  "title": "Dolgorae controller credential v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "controller_id", "kind", "instance_id", "subject_id", "capability"],
  "properties": {
    "schema_version": { "const": 1 },
    "controller_id": { "$ref": "#/$defs/uuid7" },
    "kind": { "enum": ["human_cli", "interactive_client", "workflow_orchestrator", "automation", "other"] },
    "instance_id": { "type": "string", "minLength": 1, "pattern": "^[^\\u0000-\\u001f\\u007f]+$", "x-maxUtf8Bytes": 128 },
    "subject_id": { "type": ["string", "null"], "pattern": "^[^\\u0000-\\u001f\\u007f]+$", "x-maxUtf8Bytes": 256 },
    "capability": { "type": "string", "contentEncoding": "base64url", "pattern": "^[A-Za-z0-9_-]{43}$", "x-canonicalDecodedBytes": 32 }
  },
  "$defs": {
    "uuid7": { "type": "string", "format": "uuid", "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$" }
  }
}
