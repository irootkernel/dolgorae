{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dolgorae.local/schema/interaction/v2",
  "title": "Dolgorae successor normalized interaction v2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "request_id",
    "run_id",
    "controller_id",
    "control_mode",
    "thread_id",
    "turn_id",
    "item_id",
    "run_generation",
    "server_epoch",
    "kind",
    "status",
    "payload",
    "available_decisions",
    "response_schema",
    "opened_at",
    "resolved_at",
    "resolution",
    "controller_generation"
  ],
  "properties": {
    "schema_version": {
      "const": 2
    },
    "request_id": {
      "type": "string",
      "minLength": 1,
      "x-maxUtf8Bytes": 256
    },
    "run_id": {
      "$ref": "#/$defs/uuid7"
    },
    "controller_id": {
      "$ref": "#/$defs/uuid7"
    },
    "control_mode": {
      "enum": [
        "direct_interactive",
        "managed_agent"
      ]
    },
    "thread_id": {
      "type": "string",
      "minLength": 1,
      "x-maxUtf8Bytes": 256
    },
    "turn_id": {
      "type": "string",
      "minLength": 1,
      "x-maxUtf8Bytes": 256
    },
    "item_id": {
      "type": [
        "string",
        "null"
      ],
      "x-maxUtf8Bytes": 256
    },
    "run_generation": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "server_epoch": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "kind": {
      "enum": [
        "permission_request",
        "mcp_elicitation"
      ]
    },
    "status": {
      "enum": [
        "pending",
        "resolved",
        "stale"
      ]
    },
    "payload": {
      "oneOf": [
        {
          "$ref": "#/$defs/permission_payload"
        },
        {
          "$ref": "#/$defs/mcp_payload"
        }
      ]
    },
    "available_decisions": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "enum": [
          "accept_once",
          "decline",
          "cancel"
        ]
      }
    },
    "response_schema": {
      "enum": [
        "dolgorae.interaction.permission/v2",
        "dolgorae.interaction.mcp-elicitation/v2"
      ]
    },
    "opened_at": {
      "type": "string",
      "format": "date-time"
    },
    "resolved_at": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time"
    },
    "resolution": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "$ref": "#/$defs/protected_resolution"
        },
        {
          "$ref": "#/$defs/stale_resolution"
        }
      ]
    },
    "controller_generation": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    }
  },
  "allOf": [
    {
      "oneOf": [
        {
          "properties": {
            "kind": {
              "const": "permission_request"
            },
            "payload": {
              "$ref": "#/$defs/permission_payload"
            },
            "response_schema": {
              "const": "dolgorae.interaction.permission/v2"
            },
            "available_decisions": {
              "const": [
                "accept_once",
                "decline",
                "cancel"
              ]
            }
          }
        },
        {
          "properties": {
            "kind": {
              "const": "mcp_elicitation"
            },
            "payload": {
              "$ref": "#/$defs/mcp_payload"
            },
            "response_schema": {
              "const": "dolgorae.interaction.mcp-elicitation/v2"
            }
          },
          "if": {
            "properties": {
              "payload": {
                "required": [
                  "policy_only"
                ]
              }
            }
          },
          "then": {
            "properties": {
              "available_decisions": {
                "const": [
                  "decline",
                  "cancel"
                ]
              }
            }
          },
          "else": {
            "properties": {
              "available_decisions": {
                "const": [
                  "accept_once",
                  "decline",
                  "cancel"
                ]
              }
            }
          }
        }
      ]
    },
    {
      "oneOf": [
        {
          "$ref": "#/$defs/s_pending"
        },
        {
          "$ref": "#/$defs/s_resolved"
        },
        {
          "$ref": "#/$defs/s_stale"
        }
      ]
    },
    {
      "if": {
        "properties": {
          "kind": {
            "const": "mcp_elicitation"
          },
          "status": {
            "const": "pending"
          },
          "payload": {
            "not": {
              "required": [
                "policy_only"
              ]
            }
          }
        }
      },
      "then": {
        "properties": {
          "payload": {
            "properties": {
              "questions": {
                "minItems": 1
              }
            }
          }
        }
      }
    }
  ],
  "$defs": {
    "uuid7": {
      "type": "string",
      "format": "uuid",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "option": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "label",
        "description"
      ],
      "properties": {
        "label": {
          "type": "string",
          "x-maxUtf8Bytes": 512
        },
        "description": {
          "type": "string",
          "x-maxUtf8Bytes": 4096
        }
      }
    },
    "question": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "header",
        "question",
        "is_other",
        "is_secret",
        "options"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "x-maxUtf8Bytes": 256
        },
        "header": {
          "type": "string",
          "x-maxUtf8Bytes": 512
        },
        "question": {
          "type": "string",
          "x-maxUtf8Bytes": 4096
        },
        "is_other": {
          "type": "boolean"
        },
        "is_secret": {
          "type": "boolean"
        },
        "options": {
          "type": [
            "array",
            "null"
          ],
          "maxItems": 32,
          "items": {
            "$ref": "#/$defs/option"
          }
        }
      }
    },
    "stale_resolution": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "outcome",
        "reason"
      ],
      "properties": {
        "outcome": {
          "const": "stale"
        },
        "reason": {
          "enum": [
            "upstream_cleared",
            "run_generation_changed",
            "server_epoch_changed",
            "turn_terminal",
            "file_change_snapshot_changed",
            "file_change_artifact_unavailable"
          ]
        }
      }
    },
    "s_pending": {
      "properties": {
        "status": {
          "const": "pending"
        },
        "resolved_at": {
          "type": "null"
        },
        "resolution": {
          "type": "null"
        }
      }
    },
    "s_resolved": {
      "properties": {
        "status": {
          "const": "resolved"
        },
        "resolved_at": {
          "type": "string",
          "format": "date-time"
        },
        "resolution": {
          "not": {
            "type": "null"
          }
        }
      }
    },
    "s_stale": {
      "properties": {
        "status": {
          "const": "stale"
        },
        "resolved_at": {
          "type": "string",
          "format": "date-time"
        },
        "resolution": {
          "$ref": "#/$defs/stale_resolution"
        }
      }
    },
    "permission_payload": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "title",
        "reason",
        "requested_permissions"
      ],
      "properties": {
        "title": {
          "type": "string",
          "x-maxUtf8Bytes": 512
        },
        "reason": {
          "type": "string",
          "x-maxUtf8Bytes": 4096
        },
        "requested_permissions": {
          "type": "array",
          "uniqueItems": true,
          "maxItems": 64,
          "items": {
            "type": "string",
            "x-maxUtf8Bytes": 4352
          }
        }
      }
    },
    "mcp_payload": {
      "oneOf": [
        {
          "$ref": "#/$defs/mcp_form_payload"
        },
        {
          "$ref": "#/$defs/mcp_policy_payload"
        }
      ]
    },
    "protected_resolution": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "outcome",
        "decision",
        "contained_secret",
        "answer_count",
        "resolution_receipt_id",
        "policy_cause"
      ],
      "properties": {
        "outcome": {
          "const": "protected_decision"
        },
        "decision": {
          "enum": [
            "accept_once",
            "decline",
            "cancel"
          ]
        },
        "contained_secret": {
          "const": true
        },
        "answer_count": {
          "type": "integer",
          "minimum": 0,
          "maximum": 64
        },
        "resolution_receipt_id": {
          "$ref": "#/$defs/uuid7"
        },
        "policy_cause": {
          "enum": [
            null,
            "SPECIALIST_INTERACTION_UNSUPPORTED",
            "READ_ONLY_POLICY",
            "RUNTIME_VARIANT_UNSUPPORTED"
          ]
        }
      }
    },
    "mcp_form_payload": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "title",
        "server_name",
        "questions"
      ],
      "properties": {
        "title": {
          "type": "string",
          "x-maxUtf8Bytes": 4096
        },
        "server_name": {
          "type": "string",
          "x-maxUtf8Bytes": 512
        },
        "questions": {
          "type": "array",
          "maxItems": 64,
          "items": {
            "$ref": "#/$defs/question"
          }
        }
      }
    },
    "mcp_policy_payload": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "title",
        "server_name",
        "questions",
        "policy_only"
      ],
      "properties": {
        "title": {
          "const": "MCP input"
        },
        "server_name": {
          "const": ""
        },
        "questions": {
          "const": []
        },
        "policy_only": {
          "const": "RUNTIME_VARIANT_UNSUPPORTED"
        }
      }
    }
  }
}
