{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dolgorae.local/schema/brokered-tool-result/v1",
  "title": "Dolgorae brokered Primary tool result v1",
  "oneOf": [
    {
      "$ref": "#/$defs/ok"
    },
    {
      "$ref": "#/$defs/error"
    }
  ],
  "$defs": {
    "base": {
      "type": "object",
      "properties": {
        "schema_version": {
          "const": "dolgorae.brokered-tool-result/v1"
        },
        "outcome": {
          "enum": [
            "ok",
            "error"
          ]
        }
      },
      "required": [
        "schema_version",
        "outcome"
      ]
    },
    "ok": {
      "allOf": [
        {
          "$ref": "#/$defs/base"
        },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "schema_version": {
              "const": "dolgorae.brokered-tool-result/v1"
            },
            "outcome": {
              "const": "ok"
            },
            "value": true
          },
          "required": [
            "schema_version",
            "outcome",
            "value"
          ]
        }
      ]
    },
    "error": {
      "allOf": [
        {
          "$ref": "#/$defs/base"
        },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "schema_version": {
              "const": "dolgorae.brokered-tool-result/v1"
            },
            "outcome": {
              "const": "error"
            },
            "error": {
              "$ref": "#/$defs/machine_error"
            }
          },
          "required": [
            "schema_version",
            "outcome",
            "error"
          ]
        }
      ]
    },
    "machine_error": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "code": {
          "type": "string",
          "minLength": 1
        },
        "message": {
          "type": "string",
          "minLength": 1
        },
        "retryable": {
          "type": "boolean"
        },
        "details": true
      },
      "required": [
        "code",
        "message",
        "retryable",
        "details"
      ]
    }
  }
}
