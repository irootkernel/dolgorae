{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dolgorae.local/schema/profile-server-state/v2",
  "title": "Dolgorae global Profile server state v2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "server_key", "lifecycle", "server_epoch", "epoch_id", "boot_session_uuid",
    "pid", "pgid", "uid", "process_fingerprint", "drainer_pid", "drainer_pgid", "drainer_uid",
    "drainer_fingerprint", "socket_path", "socket_device", "socket_inode", "membership_revision",
    "default_model", "models", "capabilities", "launch_snapshot_sha256", "snapshot"
  ],
  "properties": {
    "schema_version": { "const": 2 },
    "server_key": { "$ref": "https://dolgorae.local/schema/profile-server-state/v1#/$defs/sha256" },
    "lifecycle": { "enum": ["starting", "ready", "degraded", "stopping", "restarting", "migrating", "migration_blocked"] },
    "server_epoch": { "type": "integer", "minimum": 1 },
    "epoch_id": { "type": "string", "format": "uuid" },
    "boot_session_uuid": { "type": "string", "format": "uuid" },
    "pid": { "type": "integer", "minimum": 1 },
    "pgid": { "type": "integer", "minimum": 1 },
    "uid": { "type": "integer", "minimum": 0 },
    "process_fingerprint": { "type": "string", "minLength": 1 },
    "drainer_pid": { "type": "integer", "minimum": 1 },
    "drainer_pgid": { "type": "integer", "minimum": 1 },
    "drainer_uid": { "type": "integer", "minimum": 0 },
    "drainer_fingerprint": { "type": "string", "minLength": 1 },
    "socket_path": { "type": "string", "pattern": "^/" },
    "socket_device": { "type": "integer", "minimum": 0 },
    "socket_inode": { "type": "integer", "minimum": 0 },
    "membership_revision": { "type": "integer", "minimum": 0 },
    "default_model": { "type": "string", "minLength": 1 },
    "models": { "type": "array", "items": { "type": "string", "minLength": 1 }, "uniqueItems": true },
    "capabilities": { "$ref": "https://dolgorae.local/schema/profile-server-state/v1#/$defs/capabilities" },
    "launch_snapshot_sha256": { "$ref": "https://dolgorae.local/schema/profile-server-state/v1#/$defs/sha256" },
    "snapshot": { "$ref": "#/$defs/global_snapshot" }
  },
  "$defs": {
    "global_snapshot": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version", "canonical_codex_home", "normalized_argv", "launch_cwd_policy",
        "derived_launch_cwd", "sanitized_environment", "enabled_features", "disabled_features",
        "process_static_configuration", "initial_configuration_observation", "executable_identity",
        "codex_version", "schema_bundle_sha256", "compatibility_manifest_sha256",
        "launch_contract_sha256", "compatibility_verdict", "server_key"
      ],
      "properties": {
        "schema_version": { "const": 1 },
        "canonical_codex_home": { "type": "string", "pattern": "^/" },
        "normalized_argv": { "type": "array", "minItems": 1, "items": { "type": "string" } },
        "launch_cwd_policy": { "const": "profile_state_directory_v1" },
        "derived_launch_cwd": { "type": "string", "pattern": "^/" },
        "sanitized_environment": { "type": "object", "additionalProperties": { "type": "string" } },
        "enabled_features": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
        "disabled_features": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
        "process_static_configuration": { "type": "object" },
        "initial_configuration_observation": { "type": "object" },
        "executable_identity": { "$ref": "https://dolgorae.local/schema/profile-server-state/v1#/$defs/executable_identity" },
        "codex_version": { "type": "string", "minLength": 1 },
        "schema_bundle_sha256": { "$ref": "https://dolgorae.local/schema/profile-server-state/v1#/$defs/sha256" },
        "compatibility_manifest_sha256": { "$ref": "https://dolgorae.local/schema/profile-server-state/v1#/$defs/sha256" },
        "launch_contract_sha256": { "$ref": "https://dolgorae.local/schema/profile-server-state/v1#/$defs/sha256" },
        "compatibility_verdict": { "enum": ["tested", "unverified", "rejected"] },
        "server_key": { "$ref": "https://dolgorae.local/schema/profile-server-state/v1#/$defs/sha256" }
      }
    }
  },
  "x-invariants": [
    "server_key and physical generation belong to the resolved launch contract rather than a workspace",
    "launch_snapshot_sha256 binds the JCS-encoded complete snapshot",
    "membership_revision names the global membership-v2 journal revision"
  ]
}
